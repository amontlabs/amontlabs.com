---
import { getImage } from "astro:assets";
import dark from "../assets/signature/poster-dark.png";
import light from "../assets/signature/poster-light.png";

const widths = [960, 1280, 1920, 2560, 3840];
const sizes = "(max-aspect-ratio: 4/5) 62svh, max(100vw, 150svh)";
const make = async (src: ImageMetadata, format: "avif" | "webp") => {
  const imgs = await Promise.all(
    widths.map((width) => getImage({ src, width, format, quality: format === "avif" ? 55 : 80 })),
  );
  return imgs.map((i, n) => `${i.src} ${widths[n]}w`).join(", ");
};
const [darkAvif, darkWebp, lightAvif, lightWebp] = await Promise.all([
  make(dark, "avif"),
  make(dark, "webp"),
  make(light, "avif"),
  make(light, "webp"),
]);
const fallback = await getImage({ src: light, width: 1920, format: "webp", quality: 80 });
const D = "(prefers-color-scheme: dark)";
---

<section class="hero">
  <div class="scene" id="scene">
    <picture>
      <source data-theme="dark" media={D} type="image/avif" srcset={darkAvif} sizes={sizes} />
      <source data-theme="dark" media={D} type="image/webp" srcset={darkWebp} sizes={sizes} />
      <source data-theme="light" type="image/avif" srcset={lightAvif} sizes={sizes} />
      <img
        src={fallback.src}
        srcset={lightWebp}
        sizes={sizes}
        width="1920"
        height="1280"
        alt="Point-cloud rendering of a mountain range with a turquoise river flowing from its summit"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <script is:inline>window.__theme && window.__theme.sync();</script>
    <div class="live" id="live" aria-hidden="true"></div>
  </div>
  <div class="hero-text wrap">
    <h1>Independent software studio in Paris. <span>Practical, open-source software on emerging tech.</span></h1>
  </div>
</section>

<script>
  const scene = document.getElementById('scene')!;
  const live = document.getElementById('live')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const T = () => (window as unknown as { __theme: { resolved: () => string } }).__theme.resolved();

  // smooth scrolling (Lenis), advanced from the scene's own frame once it runs; until then from a plain rAF loop
  let lenis: import('lenis').default | null = null;
  let driven = false;
  let lp: Promise<void> | null = null;
  const startLenis = () => (lp ??= initLenis());
  const initLenis = async () => {
    if (reduced) return;
    const { default: Lenis } = await import('lenis');
    lenis = new Lenis({ autoRaf: false, lerp: 0.09, smoothWheel: true, anchors: true });
    const loop = (t: number) => {
      if (driven) return;
      lenis?.raf(t);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  };

  const start = async () => {
    void startLenis();
    const gl = document.createElement('canvas').getContext('webgl2');
    if (!gl) return;
    const { mount } = await import('../scripts/signature.js');
    const anchor = (): [number, number] => {
      const s = getComputedStyle(scene);
      return [parseFloat(s.getPropertyValue('--ax')), parseFloat(s.getPropertyValue('--ay'))];
    };
    const sig = await mount(live, {
      theme: T(),
      transparent: true,
      fit: 'cover',
      anchor: anchor(),
      source: 'image',
      intro: false,
      journey: true,
      lod: 'auto',
    });
    if (sig.fallback) return;
    document.addEventListener('themechange', (e) => sig.setTheme((e as CustomEvent).detail));
    let last = anchor().join();
    addEventListener('resize', () => {
      const a = anchor();
      if (a.join() !== last) { last = a.join(); sig.setFit('cover', a); }
    }, { passive: true });
    // scroll journey: tell the scene where we are, and where the source should land at the end (beside the About definition)
    const def = document.querySelector('.def') as HTMLElement | null;
    const feed = () => {
      const vh = innerHeight;
      const max = Math.max(1, document.documentElement.scrollHeight - vh);
      sig.setMetrics(vh, max);
      if (def) {
        // where the source lands at the end of the page: beside the definition (a footnote marker), or above it on narrow screens
        const r = def.getBoundingClientRect();
        const top = r.top + scrollY - max;
        const beside = r.left > 160;
        const x = beside ? r.left - 112 : r.left + 8;
        const y = beside ? top + 40 : top - 56;
        sig.setSourceTarget(x / innerWidth, y / vh);
      }
    };
    feed();
    await startLenis();
    sig.setPreFrame((t: number) => lenis?.raf(t));
    driven = true;
    addEventListener('resize', feed, { passive: true });
    new ResizeObserver(feed).observe(document.body);
    requestAnimationFrame(() => requestAnimationFrame(() => scene.classList.add('is-live')));
    if (import.meta.env.DEV) (window as unknown as { __sig: unknown }).__sig = sig;
  };

  if (!reduced) {
    const go = () => void start();
    if (document.readyState === 'complete') setTimeout(go, 0);
    else addEventListener('load', () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 200)), { once: true });
  }
</script>
