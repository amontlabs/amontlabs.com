---
// Small inline icons (16px grid, currentColor), decorative: the caller gives the text alternative.
// The brand marks (GitHub, Apple, Windows) are simplified single-colour glyphs; Linux is a plain penguin silhouette.
export type IconName = "app" | "cli" | "web" | "macos" | "linux" | "windows" | "star" | "fork" | "github" | "site" | "commit" | "merge" | "tag" | "scale" | "link" | "back";
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 14, class: cls } = Astro.props;
---

<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  {name === "app" && (
    <>
      <rect x="1.75" y="2.75" width="12.5" height="10.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M1.75 5.75h12.5" stroke="currentColor" stroke-width="1.3" />
      <circle cx="3.9" cy="4.25" r=".6" fill="currentColor" />
      <circle cx="5.7" cy="4.25" r=".6" fill="currentColor" />
    </>
  )}
  {name === "cli" && (
    <>
      <rect x="1.75" y="2.75" width="12.5" height="10.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M4.5 6.25 6.5 8l-2 1.75M8 10.25h3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {(name === "web" || name === "site") && (
    <>
      <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M1.75 8h12.5M8 1.75c1.7 1.8 2.5 3.9 2.5 6.25S9.7 12.45 8 14.25C6.3 12.45 5.5 10.35 5.5 8S6.3 3.55 8 1.75Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
    </>
  )}
  {name === "macos" && (
    <path
      fill="currentColor"
      transform="translate(1.3 .6) scale(.56)"
      d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
    />
  )}
  {name === "linux" && (
    <>
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M8 1.25c-1.85 0-2.9 1.5-2.9 3.45 0 1-.4 1.75-1.05 2.65-.8 1.1-1.55 2.45-1.55 3.95 0 .85.45 1.35 1.25 1.55l1.65.45c.65.6 1.55.95 2.6.95s1.95-.35 2.6-.95l1.65-.45c.8-.2 1.25-.7 1.25-1.55 0-1.5-.75-2.85-1.55-3.95-.65-.9-1.05-1.65-1.05-2.65 0-1.95-1.05-3.45-2.9-3.45ZM8 7.1c-1.35 0-2.3 1.55-2.3 3.35 0 1.75.95 2.85 2.3 2.85s2.3-1.1 2.3-2.85c0-1.8-.95-3.35-2.3-3.35Z"
