  {name === "link" && <path d="M6.75 9.25 9.25 6.75M7.4 4.6l1-1a2.83 2.83 0 0 1 4 4l-1 1M8.6 11.4l-1 1a2.83 2.83 0 0 1-4-4l1-1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />}
  {name === "back" && <path d="M13 8H3.25M7 4 3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
