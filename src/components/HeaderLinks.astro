---
const links = [
  { href: "mailto:hello@amontlabs.com", label: "hello@amontlabs.com", aria: "Email hello@amontlabs.com", id: "mail" },
  { href: "https://github.com/amontlabs", label: "GitHub", aria: "Amont Labs on GitHub", id: "github" },
  { href: "https://x.com/amontlabs", label: "X", aria: "Amont Labs on X", id: "x" },
];
---

<nav class="tsw tsw-links" aria-label="Contact and social">
  {links.map((l) => (
    <a href={l.href} aria-label={l.aria} data-label={l.label} {...(l.id !== "mail" ? { rel: "noopener" } : {})}>
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none">
        {l.id === "mail" && (
          <>
            <rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.75" stroke="currentColor" stroke-width="1.25" />
            <path d="M2.4 4.6 8 9.1l5.6-4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
          </>
        )}
        {l.id === "github" && (
          <path
            fill="currentColor"
            transform="translate(1 1) scale(.875)"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        )}
        {l.id === "x" && (
          <path fill="currentColor" d="M12.2 2h2.2L9.6 7.5 15.2 14h-4.4L7.4 9.6 3.5 14H1.3l5.1-5.9L1 2h4.5l3.1 4.1L12.2 2zm-.8 10.7h1.2L4.7 3.2H3.4l8 9.5z" />
        )}
      </svg>
    </a>
  ))}
</nav>
