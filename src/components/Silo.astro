---
import { Picture } from "astro:assets";
import screens from "../assets/silo/silo-screens.webp";
import data from "../data/silo.json";

const STARS_MIN = 100; // show stars only from this count up
const released = new Date(data.releasedAt);
const date = Number.isNaN(released.getTime())
  ? null
  : new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Paris" }).format(released);
const stars =
  data.stars >= 1000 ? `${(Math.floor(data.stars / 100) / 10).toFixed(1).replace(/\.0$/, "")}k stars` : `${data.stars} stars`;
const release = [data.version, date, data.stars >= STARS_MIN ? stars : null].filter(Boolean).join(" · ");

---

<section class="block" aria-labelledby="products">
  <div class="wrap grid">
    <h2 id="products" class="label mono dim" style="grid-column: 1 / -1">Products</h2>
    <p class="silo-name" aria-label="Silo">Silo</p>

    <div class="shot">
      <Picture
        src={screens}
        formats={["avif", "webp"]}
        widths={[800, 1280, 1920, 2560]}
        sizes="(max-width: 900px) 112vw, 64vw"
        alt="Silo's Linux desktop with an agent terminal, its computers list, and per-computer GitHub permissions"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="placard">
      <div class="placard-top">
        <h3 class="silo-head">Computers for your agents.</h3>
        <p>Run Linux sandboxes locally or remotely, with a desktop and computer use.</p>
      </div>
      <div>
      <p class="mono dim meta">
        <span>macOS · Linux · Open source (MIT)</span>
        <span>{release}</span>
      </p>
      <p class="silo-links">
        <a class="link is-link" href="https://silo.amontlabs.com">silo.amontlabs.com ↗</a>
        <a class="link is-link" href="https://github.com/amontlabs/silo">Source ↗</a>
      </p>
      </div>
    </div>
  </div>
</section>
