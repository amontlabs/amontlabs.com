---
// Prototype B, "Storyboard": each film is laid out as a few of its own frames, so a project can be read at a glance
// without playing anything. Every frame is a way in: it opens the film in place, with sound, at that moment, and
// the frames stay under it as chapters. No video is requested until a frame is pressed.
import { type Item, clock, items, num } from "../../data/items";
import { ground, stills } from "../../data/lab";
import Icon from "../Icon.astro";
import Facts from "./Facts.astro";

const products = items.filter((x) => x.tier === "product");
const tools = items.filter((x) => x.tier === "tool");
const stamp = (t: number) => clock(Math.floor(t));
const rows = (list: Item[]) => list.map((it) => ({ it, i: items.indexOf(it), frames: stills(it.id) }));
---

<section class="block sb" aria-labelledby="sb-h" data-sb>
  <div class="wrap">
    <h2 id="sb-h" class="label mono dim">Products</h2>
    {[products, tools].map((list, g) => (
      <>
        {g === 1 && <h3 class="label sb-tier mono dim">Tools</h3>}
        <div class:list={["sb-group", g === 1 && "is-tools"]}>
          {rows(list).map(({ it, i, frames }) => (
            <article class="sb-row" id={`sb-${it.id}`} data-film={it.film ? it.film.full : undefined} aria-labelledby={`sb-n-${it.id}`} style={`--r: ${it.film?.ratio ?? "16 / 9"}; --ground: ${ground[it.id] ?? "transparent"}; --n: ${frames.length}`}>
              <div class="sb-info">
                <p class="sb-kicker mono dim"><span>{num(i)}</span>{it.tier === "tool" ? "Released" : "In development"}</p>
                <h3 class="sb-title" id={`sb-n-${it.id}`}>{it.name}</h3>
                <p class="sb-lede">{it.line}</p>
                {it.film && it.sub && <p class="sb-sub dim">{it.sub}</p>}
                <div class="sb-facts"><Facts it={it} /></div>
                <p class="px-links sb-links">{it.links.map((l) => <a class="px-link" href={l.href}><Icon name={l.kind} /><span>{l.label}</span></a>)}</p>
              </div>

              {it.film ? (
                <div class="sb-media">
                  <div class="sb-player" hidden>
                    <video playsinline disablepictureinpicture preload="none"></video>
                    <button class="sb-hit" type="button" aria-label="Pause"></button>
                    <span class="sb-chip sb-state mono" aria-hidden="true"><b>▶</b> Play</span>
                    <div class="sb-ctl">
                      <button class="sb-chip sb-sound mono" type="button" aria-pressed="true">Sound on</button>
                      <button class="sb-chip sb-fs" type="button" aria-label="Fullscreen">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </button>
                      <button class="sb-chip sb-close mono" type="button">Close</button>
                    </div>
                    <span class="sb-bar" aria-hidden="true"><i></i></span>
                  </div>
                  <ol class="sb-strip">
                    {frames.map((f) => (
                      <li>
                        <button class="sb-frame" type="button" data-t={f.t} aria-label={`Play the ${it.name} film from ${stamp(f.t)}`}>
                          <span class="sb-pic"><img src={f.src} alt="" loading="lazy" decoding="async" /></span>
                          <span class="sb-t mono" aria-hidden="true"><b>▶</b>{stamp(f.t)}</span>
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
              ) : (
                <div class="sb-media">
                  <div class="sb-window">
                    <p>{it.sub}</p>
                    <span class="mono dim">No film yet</span>
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .sb :global(.label) {
    margin-bottom: 0;
  }
  .sb-tier {
    margin-top: 48px;
  }
  .sb-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: start;
    padding-block: 32px 40px;
    scroll-margin-top: 72px;
  }
  .sb-row + .sb-row {
    border-top: 1px solid var(--line);
  }
  .sb-info {
    grid-column: 1 / span 4;
    position: relative;
    isolation: isolate;
  }
  .sb-info::before {
    content: "";
    position: absolute;
    inset: -28px -40px;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 84%, transparent) 50%, transparent);
    pointer-events: none;
  }
  .sb-media {
    grid-column: 5 / -1;
    min-width: 0;
  }
  .sb-kicker {
    display: flex;
    gap: 12px;
    font-size: 12px;
  }
  .sb-kicker span {
    color: var(--link);
  }
  .sb-title {
    margin-top: 8px;
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .sb-lede {
    margin-top: 10px;
    font-size: 19px;
    line-height: 26px;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .sb-sub {
    margin-top: 8px;
    max-width: 34em;
    font-size: 15px;
    line-height: 24px;
    text-wrap: pretty;
  }
  .sb-facts {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .sb-links {
    margin-top: 18px;
  }

  /* ---- the frames: a contact sheet on wide screens, a strip to swipe on narrow ones */
  .sb-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sb-frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sb-pic {
    position: relative;
    display: block;
    aspect-ratio: var(--r);
    overflow: hidden;
    border-radius: 4px;
    background: var(--ground);
  }
  .sb-pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease),
      opacity 0.3s;
  }
  .sb-pic::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(247 248 245 / 0.08);
    transition: box-shadow 0.2s;
    pointer-events: none;
  }
  /* the moment, under its frame like a frame number on a contact sheet */
  .sb-t {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0 6px;
    font-size: 11px;
    line-height: 16px;
    transition: color 0.2s;
  }
  .sb-t b {
    font-weight: 400;
    font-size: 8px;
    color: var(--link);
  }
  .sb-frame:hover .sb-t,
  .sb-frame:focus-visible .sb-t,
  .sb-frame.is-now .sb-t {
    color: var(--text);
  }
  @media (hover: hover) {
    .sb-t b {
      width: 0;
      margin-right: -6px;
      overflow: hidden;
      opacity: 0;
      transition:
        width 0.25s var(--ease),
        margin 0.25s var(--ease),
        opacity 0.2s;
    }
    .sb-frame:hover .sb-t b,
    .sb-frame:focus-visible .sb-t b {
      width: 8px;
      margin-right: 0;
      opacity: 1;
    }
    .sb-frame:hover .sb-pic img {
      transform: scale(1.03);
    }
    .sb-frame:hover .sb-pic::after {
      box-shadow: inset 0 0 0 1px rgb(247 248 245 / 0.32);
    }
  }

  /* open: the film plays above, the frames shrink into its chapters */
  .sb-row.is-open .sb-strip {
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin-top: 8px;
  }
  .sb-row.is-open .sb-pic img {
    opacity: 0.5;
  }
  .sb-row.is-open .sb-frame:is(.is-now, :hover) .sb-pic img {
    opacity: 1;
  }
  .sb-row.is-open .sb-frame.is-now .sb-pic::after {
    box-shadow: inset 0 0 0 1.5px var(--fonte);
  }
  .sb-player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: var(--ground);
  }
  .sb-player video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sb-hit {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .sb-hit:focus-visible {
    outline-offset: -4px;
  }
  .sb-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: rgb(16 20 24 / 0.78);
    color: #f7f8f5;
    font-size: 12px;
    line-height: 16px;
    cursor: pointer;
  }
  .sb-chip::after {
    content: "";
    position: absolute;
    inset: -8px -3px;
  }
  .sb-sound[aria-pressed="true"] {
    background: #f7f8f5;
    color: #101418;
  }
  .sb-ctl {
    position: absolute;
    right: 10px;
    bottom: 12px;
    display: flex;
    gap: 6px;
  }
  .sb-state {
    position: absolute;
    left: 10px;
    bottom: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .sb-state b {
    font-weight: 400;
    font-size: 9px;
  }
  .sb-player.is-paused .sb-state {
    opacity: 1;
  }
  .sb-bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: rgb(247 248 245 / 0.14);
    pointer-events: none;
  }
  .sb-bar i {
    display: block;
    height: 100%;
    background: var(--fonte);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* Fjord: no film, so no frames; an open frame onto the river with its sentence */
  .sb-window {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    min-height: 168px;
    padding: 28px 32px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .sb-window p {
    max-width: 24em;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 500;
    text-wrap: balance;
    position: relative;
    isolation: isolate;
  }
  .sb-window p::before {
    content: "";
    position: absolute;
    inset: -28px -40px;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 82%, transparent) 40%, transparent);
  }

  /* tools: lighter. Two side by side, one row of small frames each */
  .is-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .is-tools .sb-row {
    display: block;
    border-top: 0;
    padding-bottom: 0;
  }
  .is-tools .sb-media {
    margin-top: 20px;
  }
  .is-tools .sb-strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .is-tools .sb-title {
    font-size: 26px;
  }
  .is-tools .sb-lede {
    font-size: 17px;
    line-height: 24px;
  }
  .is-tools .sb-sub {
    display: none;
  }

  @media (max-width: 999px) {
    .sb-row {
      display: block;
      padding-block: 28px 32px;
    }
    .sb-sub {
      display: none;
    }
    .sb-media {
      margin-top: 20px;
    }
    /* the strip runs edge to edge and swipes */
    .sb-strip,
    .sb-row.is-open .sb-strip,
    .is-tools .sb-strip {
      --fh: 150px;
      display: flex;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .sb-strip::-webkit-scrollbar {
      display: none;
    }
    .sb-strip li {
      flex: none;
      scroll-snap-align: start;
    }
    .sb-frame {
      width: auto;
    }
    .sb-pic {
      height: var(--fh);
    }
    .is-tools .sb-strip {
      --fh: 112px;
    }
    .sb-row.is-open .sb-strip {
      --fh: 60px;
    }
    .sb-player {
      margin-inline: calc(var(--gutter) * -1);
      border-radius: 0;
      aspect-ratio: var(--r); /* a 4:3 film gets its full height on a phone */
    }
    .is-tools {
      display: block;
    }
    .is-tools .sb-row + .sb-row {
      border-top: 1px solid var(--line);
      margin-top: 32px;
    }
    .sb-window {
      min-height: 150px;
      padding: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-pic img,
    .sb-t b {
      transition: none;
    }
  }
</style>

<style is:global>
  /* the pressed frame grows into the player (and back) */
  ::view-transition-group(sb-film) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  ::view-transition-old(sb-film),
  ::view-transition-new(sb-film) {
    height: 100%;
    object-fit: cover;
  }
  html.sb-vt::view-transition-old(root),
  html.sb-vt::view-transition-new(root) {
    animation-duration: 0.3s;
  }
</style>

<script>
  // Event-driven only. Nothing here touches the network until a frame is pressed.
  const root = document.querySelector<HTMLElement>('[data-sb]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SCALE = [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }];
  const vt = (fn: () => void) => {
    const d = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (reduced || !d.startViewTransition) { fn(); return; }
    d.documentElement.classList.add('sb-vt');
    d.startViewTransition(fn).finished.finally(() => d.documentElement.classList.remove('sb-vt'));
  };

  type Row = { el: HTMLElement; player: HTMLElement; v: HTMLVideoElement; frames: HTMLButtonElement[]; times: number[]; bar: Animation | null; now: number; close: () => void };
  let open: Row | null = null;

  const rows: Row[] = [...root.querySelectorAll<HTMLElement>('.sb-row[data-film]')].map((el) => {
    const player = el.querySelector<HTMLElement>('.sb-player')!;
    const v = player.querySelector('video')!;
    const frames = [...el.querySelectorAll<HTMLButtonElement>('.sb-frame')];
    const row: Row = { el, player, v, frames, times: frames.map((f) => Number(f.dataset.t)), bar: null, now: -1, close: () => {} };
    const soundB = player.querySelector<HTMLButtonElement>('.sb-sound')!;
    const hit = player.querySelector<HTMLButtonElement>('.sb-hit')!;

    const sync = () => {
      if (!Number.isFinite(v.duration) || !v.duration) return;
      row.bar ??= player.querySelector('.sb-bar i')!.animate(SCALE, { duration: v.duration * 1000, fill: 'both' });
      row.bar.currentTime = v.currentTime * 1000;
      if (v.paused || v.seeking || v.readyState < 3) row.bar.pause(); else row.bar.play();
      player.classList.toggle('is-paused', v.paused && !v.ended);
      hit.setAttribute('aria-label', v.paused ? 'Play' : 'Pause');
    };
    for (const ev of ['playing', 'pause', 'seeked', 'seeking', 'waiting', 'loadedmetadata']) v.addEventListener(ev, sync, { passive: true });
    // the chapter being played: the last frame whose moment has passed
    v.addEventListener('timeupdate', () => {
      let n = 0;
      for (let k = 0; k < row.times.length; k++) if (v.currentTime >= row.times[k] - 0.05) n = k;
      if (n === row.now) return;
      row.now = n;
      frames.forEach((f, k) => f.classList.toggle('is-now', k === n));
    }, { passive: true });
    const mute = (m: boolean) => {
      v.muted = m;
      soundB.setAttribute('aria-pressed', String(!m));
      soundB.textContent = m ? 'Sound off' : 'Sound on';
    };
    const play = () => void v.play().catch(() => { if (!v.muted) { mute(true); void v.play().catch(() => {}); } });

    const start = (frame: HTMLButtonElement) => {
      const t = Number(frame.dataset.t);
      if (open === row) { v.currentTime = t; play(); return; }
      const pic = frame.querySelector<HTMLElement>('.sb-pic')!;
      pic.style.viewTransitionName = 'sb-film';
      vt(() => {
        pic.style.viewTransitionName = '';
        open?.close();
        open = row;
        el.classList.add('is-open');
        player.hidden = false;
        player.style.viewTransitionName = 'sb-film';
        v.poster = frame.querySelector('img')!.currentSrc;
        v.src = el.dataset.film!;
        mute(false);
        v.addEventListener('loadedmetadata', () => { v.currentTime = t; }, { once: true });
        play();
      });
      setTimeout(() => { player.style.viewTransitionName = ''; player.scrollIntoView({ block: 'nearest', behavior: reduced ? 'auto' : 'smooth' }); }, 500);
    };
    row.close = () => {
      v.pause();
      v.removeAttribute('src');
      v.load();
      row.bar?.cancel();
      row.bar = null;
      row.now = -1;
      el.classList.remove('is-open');
      player.hidden = true;
      player.classList.remove('is-paused');
      for (const f of frames) f.classList.remove('is-now');
      if (open === row) open = null;
    };
    const closeBack = () => {
      const back = frames[Math.max(0, row.now)], pic = back.querySelector<HTMLElement>('.sb-pic')!;
      player.style.viewTransitionName = 'sb-film';
      vt(() => {
        player.style.viewTransitionName = '';
        pic.style.viewTransitionName = 'sb-film';
        row.close();
        back.focus({ preventScroll: true });
      });
      setTimeout(() => { pic.style.viewTransitionName = ''; }, 500);
    };

    for (const f of frames) f.addEventListener('click', () => start(f));
    hit.addEventListener('click', () => (v.paused ? play() : v.pause()));
    soundB.addEventListener('click', () => mute(!v.muted));
    player.querySelector('.sb-close')!.addEventListener('click', closeBack);
    player.querySelector('.sb-fs')!.addEventListener('click', () => {
      const w = v as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (document.fullscreenElement) void document.exitFullscreen();
      else if (player.requestFullscreen) void player.requestFullscreen();
      else w.webkitEnterFullscreen?.();
    });
    el.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open === row) closeBack(); });
    v.addEventListener('ended', closeBack);
    return row;
  });

  // a playing film that leaves the screen pauses
  const off = new IntersectionObserver((es) => {
    for (const e of es) if (!e.isIntersecting) rows.find((r) => r.player === e.target)?.v.pause();
  });
  for (const r of rows) off.observe(r.player);
  document.addEventListener('fullscreenchange', () => document.dispatchEvent(new CustomEvent('px:viewer', { detail: { open: !!document.fullscreenElement } })));
</script>
