---
// Prototype C, "Lines": the five sentences are the showcase. Read top to bottom they say what the lab makes; each one
// opens in place onto its film (one open at a time, Silo first). The rule under the open line is its film's progress.
import { items, num } from "../../data/items";
import { ground } from "../../data/lab";
import Icon from "../Icon.astro";
import Facts from "./Facts.astro";
---

<section class="block ln" aria-labelledby="ln-h" data-ln>
  <div class="wrap">
    <h2 id="ln-h" class="label mono dim">Products</h2>
    <ol class="ln-list">
      {items.map((it, i) => (
        <>
          {it.tier === "tool" && items[i - 1]?.tier !== "tool" && <li class="ln-tier mono dim">Tools</li>}
          <li class:list={["ln-row", i === 0 && "is-open", it.tier === "tool" && "is-tool"]} data-id={it.id} style={`--ground: ${ground[it.id] ?? "transparent"}; --r: ${it.film?.ratio ?? "16 / 9"}`}>
            <h3 class="ln-h">
              <button class="ln-head" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`ln-b-${it.id}`}>
                <span class="ln-id"><span class="mono">{num(i)}</span>{it.name}</span>
                <span class="ln-line">{it.line}</span>
                <span class="ln-end" aria-hidden="true">
                  {it.film && <img class="ln-thumb" src={`/media/${it.film.id}-640.webp`} width="640" height={it.film.ratio === "4 / 3" ? 480 : 360} alt="" loading="lazy" decoding="async" />}
                  <span class="ln-mark"></span>
                </span>
              </button>
              <span class="ln-rule" aria-hidden="true"><i></i></span>
            </h3>
            <div class="ln-body" id={`ln-b-${it.id}`}>
              <div class="ln-in">
                {it.film ? (
                  <div class="ln-film" data-prev={`/media/${it.film.id}.mp4`} data-full={it.film.full}>
                    <img src={`/media/${it.film.id}-1280.webp`} srcset={`/media/${it.film.id}-640.webp 640w, /media/${it.film.id}-1280.webp 1280w`} sizes="(max-width: 899px) 100vw, 58vw" alt="" loading="lazy" decoding="async" />
                    <video muted loop playsinline disablepictureinpicture disableremoteplayback preload="none" aria-hidden="true"></video>
                    <button class="ln-hit" type="button" aria-label="Pause"></button>
                    <span class="ln-chip ln-state mono" aria-hidden="true"><b>▶</b> Play</span>
                    <div class="ln-ctl">
                      <button class="ln-chip ln-sound mono" type="button" aria-pressed="false">Sound off</button>
                      <button class="ln-chip ln-fs" type="button" aria-label="Fullscreen">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </button>
                    </div>
                  </div>
                ) : (
                  <div class="ln-film is-window">
                    <p>{it.sub}</p>
                    <span class="mono dim">No film yet</span>
                  </div>
                )}
                <div class="ln-side">
                  <p class="mono dim ln-status">{it.tier === "tool" ? "Released" : "In development"}</p>
                  {it.film && it.sub && <p class="ln-sub">{it.sub}</p>}
                  <div class="ln-facts"><Facts it={it} /></div>
                  <p class="px-links ln-links">{it.links.map((l) => <a class="px-link" href={l.href}><Icon name={l.kind} /><span>{l.label}</span></a>)}</p>
                </div>
              </div>
            </div>
          </li>
        </>
      ))}
    </ol>
  </div>
</section>

<style>
  .ln :global(.label) {
    margin-bottom: 8px;
  }
  .ln-list {
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
    isolation: isolate;
  }
  /* the list is text over the river: one soft ground behind all of it */
  .ln-list::before {
    content: "";
    position: absolute;
    inset: -24px calc(var(--gutter) * -1);
    z-index: -1;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 80%, transparent) 48px, color-mix(in srgb, var(--bg) 80%, transparent) calc(100% - 48px), transparent);
    pointer-events: none;
  }
  .ln-row {
    scroll-margin-block: 72px 24px;
  }
  .ln-tier {
    padding: 40px 0 4px;
    font-size: 12px;
  }
  .ln-h {
    position: relative;
    font: inherit;
  }
  .ln-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    width: 100%;
    padding: 22px 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .ln-head:focus-visible {
    outline-offset: -2px;
  }
  .ln-id {
    grid-column: 1 / span 2;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .ln-id .mono {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--secondary);
    transition: color 0.2s;
  }
  .ln-row.is-open .ln-id .mono {
    color: var(--link);
  }
  .ln-line {
    grid-column: 3 / span 8;
    font-size: clamp(26px, 3.3vw, 46px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: color-mix(in srgb, var(--text) 46%, transparent);
    transition: color 0.3s;
  }
  .ln-row.is-open .ln-line,
  .ln-head:hover .ln-line,
  .ln-head:focus-visible .ln-line {
    color: var(--text);
  }
  .ln-end {
    grid-column: 11 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }
  /* a still from the film at the end of its line; it leaves when the film itself is open */
  .ln-thumb {
    width: 96px;
    height: 54px;
    object-fit: cover;
    border-radius: 3px;
    background: var(--ground);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease);
    transform-origin: 100% 50%;
  }
  .ln-row.is-open .ln-thumb {
    opacity: 0;
    transform: scale(0.8);
  }
  @media (hover: hover) {
    .ln-row:not(.is-open) .ln-head:hover .ln-thumb {
      transform: scale(1.5);
    }
  }
  .ln-mark {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--secondary);
  }
  .ln-mark::before,
  .ln-mark::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 13px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .ln-mark::after {
    transform: rotate(90deg);
  }
  .ln-row.is-open .ln-mark::after {
    transform: rotate(0deg);
  }
  /* the rule under each line; under the open one it is the film's progress */
  .ln-rule {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--line);
    pointer-events: none;
  }
  .ln-rule i {
    display: block;
    height: 100%;
    background: var(--fonte);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .ln-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--ease);
  }
  .ln-row.is-open .ln-body {
    grid-template-rows: 1fr;
  }
  .ln-list.is-snap .ln-body {
    transition: none;
  }
  .ln-in {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: start;
    transition: visibility 0s 0.55s;
  }
  .ln-row.is-open .ln-in {
    visibility: visible;
    transition-delay: 0s;
  }
  .ln-film {
    grid-column: 3 / span 7;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-block: 24px 40px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--ground);
    max-height: calc(100svh - 260px);
  }
  .ln-film > img,
  .ln-film video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ln-film video {
    opacity: 0;
  }
  .ln-film.is-live video {
    opacity: 1;
    transition: opacity 0.3s;
  }
  .ln-film.is-window {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    aspect-ratio: auto;
    min-height: 200px;
    padding: 32px;
    background: none;
    border: 1px solid var(--line);
  }
  .ln-film.is-window p {
    max-width: 24em;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ln-side {
    grid-column: 10 / -1;
    display: grid;
    gap: 16px;
    padding-block: 24px 40px;
    align-content: start;
  }
  .ln-status {
    font-size: 12px;
  }
  .ln-sub {
    font-size: 15px;
    line-height: 24px;
    text-wrap: pretty;
  }
  .ln-facts {
    display: grid;
    gap: 10px;
  }
  .ln-hit {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .ln-hit:focus-visible {
    outline-offset: -4px;
  }
  .ln-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: rgb(16 20 24 / 0.78);
    color: #f7f8f5;
    font-size: 12px;
    line-height: 16px;
    cursor: pointer;
  }
  .ln-chip::after {
    content: "";
    position: absolute;
    inset: -8px -3px;
  }
  .ln-sound[aria-pressed="true"] {
    background: #f7f8f5;
    color: #101418;
  }
  .ln-ctl {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
  }
  .ln-state {
    position: absolute;
    left: 10px;
    bottom: 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .ln-state b {
    font-weight: 400;
    font-size: 9px;
  }
  .ln-film.is-paused .ln-state {
    opacity: 1;
  }

  /* tools: the same line, lighter */
  .is-tool .ln-head {
    padding: 14px 0;
  }
  .is-tool .ln-id {
    font-size: 17px;
  }
  .is-tool .ln-line {
    font-size: clamp(19px, 2vw, 26px);
    letter-spacing: -0.025em;
  }
  .is-tool .ln-thumb {
    width: 64px;
    height: 36px;
  }
  .is-tool .ln-film {
    grid-column: 3 / span 5;
  }
  .is-tool .ln-side {
    grid-column: 8 / -1;
    max-width: 30em;
  }

  @media (max-width: 899px) {
    .ln-head {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 8px;
      padding: 18px 0 20px;
    }
    .ln-id {
      grid-column: 1;
      font-size: 17px;
      line-height: 24px;
    }
    .ln-end {
      grid-column: 2;
      grid-row: 1;
      gap: 14px;
    }
    .ln-line {
      grid-column: 1 / -1;
      font-size: 26px;
      line-height: 1.12;
    }
    .ln-thumb,
    .is-tool .ln-thumb {
      width: 43px;
      height: 24px;
      border-radius: 2px;
    }
    .is-tool .ln-line {
      font-size: 19px;
    }
    .is-tool .ln-head {
      padding: 14px 0 16px;
    }
    .ln-in {
      display: block;
    }
    .ln-film,
    .is-tool .ln-film {
      margin: 16px 0 0;
      max-height: none;
      aspect-ratio: var(--r); /* a 4:3 film gets its full height on a phone */
    }
    .ln-film.is-window {
      aspect-ratio: auto;
    }
    .ln-film.is-window {
      padding: 20px;
      min-height: 150px;
    }
    .ln-side,
    .is-tool .ln-side {
      padding-block: 20px 32px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-body,
    .ln-thumb,
    .ln-mark::before,
    .ln-mark::after,
    .ln-line {
      transition: none;
    }
    .ln-in {
      transition-duration: 0s;
      transition-delay: 0s;
    }
  }
</style>

<script>
  // Event-driven only: no animation-frame loop. Only the open line's film is ever loaded or played.
  const root = document.querySelector<HTMLElement>('[data-ln]')!;
  const list = root.querySelector<HTMLElement>('.ln-list')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const SCALE = [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }];

  type Row = { el: HTMLElement; head: HTMLButtonElement; film: HTMLElement | null; v: HTMLVideoElement | null; bar: Animation | null; ratio: number };
  const rows: Row[] = [...root.querySelectorAll<HTMLElement>('.ln-row')].map((el) => {
    const film = el.querySelector<HTMLElement>('.ln-film[data-prev]');
    return { el, head: el.querySelector<HTMLButtonElement>('.ln-head')!, film, v: film?.querySelector('video') ?? null, bar: null, ratio: 0 };
  });
  let open: Row | null = rows.find((r) => r.el.classList.contains('is-open')) ?? null;
  let held = reduced, sound = false, fit = 0;

  const big = (r: Row) => !saveData && r.film!.clientWidth * Math.min(devicePixelRatio, 2) >= 1500;
  const src = (r: Row) => (sound || big(r) ? r.film!.dataset.full! : r.film!.dataset.prev!);

  function apply() {
    for (const r of rows) {
      if (!r.v || !r.film) continue;
      const want = r === open && r.ratio >= 0.5 && !held && !document.hidden;
      if (r === open) {
        r.film.classList.toggle('is-paused', held);
        r.film.querySelector('.ln-hit')!.setAttribute('aria-label', held ? 'Play' : 'Pause');
      }
      if (!want) { if (!r.v.paused) r.v.pause(); continue; }
      if (!r.v.getAttribute('src')) { r.v.src = src(r); r.v.muted = !sound; }
      if (r.v.paused) void r.v.play().catch(() => {
        if (r.v!.muted) return;
        setSound(false);
        void r.v!.play().catch(() => {});
      });
    }
  }
  function setSound(on: boolean) {
    sound = on;
    for (const b of root.querySelectorAll<HTMLButtonElement>('.ln-sound')) { b.setAttribute('aria-pressed', String(on)); b.textContent = on ? 'Sound on' : 'Sound off'; }
    const r = open;
    if (!r?.v) return;
    r.v.muted = !on;
    // the preview has no sound track: move to the full film at the same moment
    if (on && !r.v.src.endsWith(r.film!.dataset.full!)) {
      const t = r.v.currentTime;
      r.v.src = r.film!.dataset.full!;
      r.v.addEventListener('loadedmetadata', () => { r.v!.currentTime = t; }, { once: true });
    }
  }

  function toggle(r: Row) {
    const prev = open;
    const before = r.head.getBoundingClientRect().top;
    // a line above that closes would pull this one away from the pointer: close it at once and hold the scroll position
    const snap = !!prev && prev !== r && rows.indexOf(prev) < rows.indexOf(r);
    if (snap) list.classList.add('is-snap');
    if (prev) {
      prev.el.classList.remove('is-open');
      prev.head.setAttribute('aria-expanded', 'false');
      if (prev.v) { prev.v.pause(); prev.v.removeAttribute('src'); prev.v.load(); prev.film!.classList.remove('is-live'); }
      prev.bar?.cancel();
      prev.bar = null;
    }
    if (snap) {
      scrollBy(0, r.head.getBoundingClientRect().top - before);
      list.classList.remove('is-snap');
      void list.offsetHeight;
    }
    open = prev === r ? null : r;
    if (open) {
      r.el.classList.add('is-open');
      r.head.setAttribute('aria-expanded', 'true');
      held = reduced;
      // once it has opened, bring the whole line and its film on screen if they are not
      clearTimeout(fit);
      fit = window.setTimeout(() => r.el.scrollIntoView({ block: 'nearest', behavior: reduced ? 'auto' : 'smooth' }), reduced ? 0 : 580);
    }
    apply();
  }

  for (const r of rows) {
    r.head.addEventListener('click', () => toggle(r));
    if (!r.v || !r.film) continue;
    const v = r.v, film = r.film;
    const sync = () => {
      if (r !== open || !Number.isFinite(v.duration) || !v.duration) return;
      r.bar ??= r.el.querySelector('.ln-rule i')!.animate(SCALE, { duration: v.duration * 1000, iterations: Infinity });
      r.bar.currentTime = v.currentTime * 1000;
      if (v.paused || v.seeking || v.readyState < 3) r.bar.pause(); else r.bar.play();
    };
    for (const ev of ['playing', 'pause', 'seeked', 'seeking', 'waiting', 'loadedmetadata']) v.addEventListener(ev, sync, { passive: true });
    v.addEventListener('playing', () => film.classList.add('is-live'), { passive: true });
    film.querySelector('.ln-hit')!.addEventListener('click', () => { held = !held; apply(); });
    film.querySelector('.ln-sound')!.addEventListener('click', () => { setSound(!sound); if (sound) held = false; apply(); });
    film.querySelector('.ln-fs')!.addEventListener('click', () => {
      const w = v as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (document.fullscreenElement) void document.exitFullscreen();
      else if (film.requestFullscreen) void film.requestFullscreen();
      else w.webkitEnterFullscreen?.();
    });
  }

  const byFilm = new Map(rows.filter((r) => r.film).map((r) => [r.film as Element, r]));
  const seen = new IntersectionObserver((es) => {
    for (const e of es) byFilm.get(e.target)!.ratio = e.intersectionRatio;
    apply();
  }, { threshold: [0, 0.5, 1] });
  for (const r of rows) if (r.film) seen.observe(r.film);
  document.addEventListener('visibilitychange', apply);
  document.addEventListener('fullscreenchange', () => document.dispatchEvent(new CustomEvent('px:viewer', { detail: { open: !!document.fullscreenElement } })));
</script>
