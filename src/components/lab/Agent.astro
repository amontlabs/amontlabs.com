---
// Prototype E, "Agent": the showcase is a page an agent is using. A second cursor reads the section, presses each
// project and watches its film; before it acts, the element it is about to use lights up with the role and name
// an agent reads from it (taken live from the DOM). A click, tap or key from the visitor takes control at once;
// one button hands it back. The run is scripted: no model is behind it, and the log only names what happens here.
import { clock, items, num } from "../../data/items";
import { ground } from "../../data/lab";
import Icon from "../Icon.astro";
import Facts from "./Facts.astro";

const first = items[0];
const data = items.map((it) => ({
  id: it.id,
  name: it.name,
  ground: ground[it.id] ?? "",
  film: it.film ? { prev: `/media/${it.film.id}.mp4`, full: it.film.full, dur: it.film.dur } : null,
}));
---

<section class="block ag" aria-labelledby="ag-h" data-ag>
  <div class="wrap ag-grid">
    <div class="ag-left">
      <h2 id="ag-h" class="label mono dim">Products</h2>
      <ol class="ag-list" aria-label="Projects">
        {items.map((it, i) => (
          <>
            {it.tier === "tool" && items[i - 1]?.tier !== "tool" && <li class="ag-tier mono dim">Tools</li>}
            <li>
              <button class:list={["ag-row", i === 0 && "is-on", it.tier === "tool" && "is-tool"]} type="button" aria-pressed={i === 0 ? "true" : "false"} aria-label={`${it.name}. ${it.line}`}>
                <span class="ag-n mono" aria-hidden="true">{num(i)}</span>
                <span class="ag-name">{it.name}</span>
                <span class="ag-line">{it.line}</span>
                <i aria-hidden="true"><b></b></i>
              </button>
            </li>
          </>
        ))}
      </ol>

      <div class="ag-desk mono" aria-hidden="true">
        <div class="ag-status">
          <span class="ag-who"><i></i><span class="ag-who-t">Agent has control</span></span>
          <button class="ag-btn ag-hand" type="button" tabindex="-1">Take over</button>
        </div>
        <ol class="ag-log"></ol>
        <button class="ag-btn ag-see" type="button" tabindex="-1" aria-pressed="false"><i></i>What it sees</button>
      </div>
    </div>

    <div class="ag-right">
      <div class="ag-stage" data-kind="film" style={`--ground: ${ground[first.id]}`}>
        <img class="ag-poster" src={`/media/${first.id}-1280.webp`} srcset={`/media/${first.id}-640.webp 640w, /media/${first.id}-1280.webp 1280w`} sizes="(max-width: 899px) 100vw, 66vw" alt="" loading="lazy" decoding="async" />
        <video muted playsinline disablepictureinpicture disableremoteplayback preload="none" aria-label={`${first.name} film`}></video>
        {items.filter((it) => !it.film).map((it) => (
          <div class="ag-window" data-id={it.id}>
            <p>{it.sub}</p>
            <span class="mono dim">No film yet</span>
          </div>
        ))}
        <button class="ag-hit" type="button" aria-label="Pause"></button>
        <span class="ag-chip ag-state mono" aria-hidden="true"><b>▶</b> Play</span>
        <div class="ag-ctl">
          <button class="ag-chip ag-sound mono" type="button" aria-pressed="false">Sound off</button>
          <button class="ag-chip ag-fs" type="button" aria-label="Fullscreen">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>
      <div class="ag-info">
        {items.map((it, i) => (
          <article class:list={["ag-pan", i === 0 && "is-on"]} inert={i !== 0}>
            <div>
              <h3 class="ag-title">{it.name}<span class="mono dim">{it.tier === "tool" ? "Released" : "In development"}</span></h3>
              <p class="ag-lede">{it.line}</p>
              {it.film && it.sub && <p class="ag-sub dim">{it.sub}</p>}
            </div>
            <div class="ag-facts">
              <Facts it={it} />
              <p class="px-links">{it.links.map((l) => <a class="px-link" href={l.href}><Icon name={l.kind} /><span>{l.label}</span></a>)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
  {/* what the agent reads, drawn over the page, and its cursor */}
  <div class="ag-ax" aria-hidden="true"></div>
  <div class="ag-cur" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 22 22"><path d="M4 2.5 17.5 10l-6 1.6L9 17.5Z" fill="#f7f8f5" stroke="#101418" stroke-width="1.5" stroke-linejoin="round" /></svg>
    <span class="mono">agent</span>
    <i></i>
  </div>
  <script type="application/json" id="ag-data" set:html={JSON.stringify(data)} />
  <template id="ag-clock">{items.map((it) => it.film ? clock(it.film.dur) : "").join(",")}</template>
</section>

<style is:global>
  .ag {
    position: relative;
  }
  .ag .label {
    margin-bottom: 8px;
  }
  .ag-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    column-gap: calc(var(--gutter) * 1.5);
    align-items: start;
  }
  .ag-left {
    position: relative;
    isolation: isolate;
  }
  .ag-left::before,
  .ag-info::before {
    content: "";
    position: absolute;
    inset: -24px -32px;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bg) 86%, transparent) 60%, transparent);
    pointer-events: none;
  }

  /* ---- the projects: what the agent presses */
  .ag-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-tier {
    padding: 14px 0 0;
    font-size: 12px;
  }
  .ag-row {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 4px;
    align-items: baseline;
    width: 100%;
    padding: 12px 0 13px;
    border: 0;
    background: none;
    color: var(--secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      color 0.25s,
      transform 0.15s;
  }
  .ag-n {
    font-size: 12px;
  }
  .ag-name {
    font-size: 22px;
    line-height: 28px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  .ag-line {
    grid-column: 2;
    font-size: 15px;
    line-height: 22px;
  }
  .ag-row i {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--line);
  }
  .ag-row b {
    display: block;
    height: 100%;
    background: var(--fonte);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .ag-row:hover .ag-name,
  .ag-row.is-on .ag-name {
    opacity: 1;
  }
  .ag-row.is-on {
    color: var(--text);
  }
  .ag-row.is-on .ag-n {
    color: var(--link);
  }
  .ag-row.is-press {
    transform: scale(0.985);
  }
  .ag-row.is-tool {
    padding: 9px 0 10px;
  }
  .ag-row.is-tool .ag-name {
    font-size: 18px;
    line-height: 24px;
  }
  .ag-row.is-tool .ag-line {
    font-size: 14px;
    line-height: 20px;
  }

  /* ---- the agent's desk: who has control, what it just did */
  .ag-desk {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    font-size: 12px;
    line-height: 18px;
  }
  .ag-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .ag-who {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ag-who i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fonte);
  }
  .ag.is-you .ag-who i {
    background: var(--secondary);
  }
  .ag:not(.is-you):not(.is-done) .ag-who i {
    animation: ag-beat 1.6s ease-in-out infinite;
  }
  @keyframes ag-beat {
    50% {
      opacity: 0.3;
    }
  }
  .ag-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .ag-btn::after {
    content: "";
    position: absolute;
    inset: -9px -4px;
  }
  .ag-btn:hover {
    border-color: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .ag-see {
    justify-self: start;
  }
  .ag-see i {
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 2px;
  }
  .ag-see[aria-pressed="true"] {
    border-color: var(--fonte);
  }
  .ag-see[aria-pressed="true"] i {
    background: var(--fonte);
    border-color: var(--fonte);
  }
  .ag-log {
    display: grid;
    align-content: end;
    height: 90px; /* five lines */
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 60%);
    mask-image: linear-gradient(transparent, #000 60%);
  }
  .ag-log li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 8px;
    color: var(--secondary);
    white-space: nowrap;
    animation: ag-in 0.3s var(--ease) both;
  }
  .ag-log li span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ag-log li:last-child {
    color: var(--text);
  }
  .ag-log li b {
    font-weight: 400;
    color: var(--link);
  }
  @keyframes ag-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* ---- stage */
  .ag-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: calc(100svh - 300px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 4px;
    background: var(--ground);
    isolation: isolate;
    transition: background-color 0.4s;
  }
  .ag-stage[data-kind="film"]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(247 248 245 / 0.07);
    pointer-events: none;
  }
  .ag-stage[data-kind="window"] {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ag-poster,
  .ag-stage video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ag-stage video {
    opacity: 0;
  }
  .ag-stage.is-live video {
    opacity: 1;
    transition: opacity 0.3s;
  }
  .ag-stage[data-kind="window"] :is(.ag-poster, video, .ag-ctl, .ag-hit, .ag-state) {
    visibility: hidden;
  }
  .ag-window {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 8%;
  }
  .ag-stage[data-kind="window"] .ag-window.is-on {
    display: flex;
  }
  .ag-window p {
    max-width: 22em;
    font-size: clamp(20px, 2.5vw, 34px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .ag-hit {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .ag-hit:focus-visible {
    outline-offset: -4px;
  }
  .ag-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: rgb(16 20 24 / 0.78);
    color: #f7f8f5;
    font-size: 12px;
    line-height: 16px;
    cursor: pointer;
  }
  .ag-chip::after {
    content: "";
    position: absolute;
    inset: -8px -3px;
  }
  .ag-sound[aria-pressed="true"] {
    background: #f7f8f5;
    color: #101418;
  }
  .ag-ctl {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }
  .ag-state {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .ag-state b {
    font-weight: 400;
    font-size: 9px;
  }
  .ag-stage.is-paused .ag-state {
    opacity: 1;
  }

  /* ---- the project on stage */
  .ag-info {
    display: grid;
    position: relative;
    isolation: isolate;
    margin-top: 20px;
  }
  .ag-pan {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: start;
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
  }
  .ag-pan.is-on {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s 0.05s,
      transform 0.5s 0.05s var(--ease);
  }
  .ag-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: clamp(28px, 2.8vw, 38px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .ag-title .mono {
    font-size: 12px;
    letter-spacing: 0;
  }
  .ag-lede {
    margin-top: 8px;
    font-size: 19px;
    line-height: 26px;
    letter-spacing: -0.015em;
  }
  .ag-sub {
    margin-top: 6px;
    font-size: 15px;
    line-height: 23px;
    text-wrap: pretty;
  }
  .ag-facts {
    display: grid;
    gap: 10px;
    padding-top: 6px;
    justify-items: start;
  }
  .ag-facts .px-links {
    margin-top: 6px;
  }

  /* ---- what the agent sees: role and name over the element, from the DOM */
  .ag-ax {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .ag-box {
    position: absolute;
    border: 1px solid var(--fonte);
    border-radius: 5px;
    background: color-mix(in srgb, var(--fonte) 7%, transparent);
    animation: ag-box 0.28s var(--ease) both;
  }
  .ag-box.is-out {
    opacity: 0;
    transition: opacity 0.35s;
  }
  .ag-box span {
    position: absolute;
    left: -1px;
    bottom: calc(100% + 3px);
    max-width: min(320px, 80vw);
    padding: 0 6px;
    border-radius: 3px;
    background: var(--fonte);
    color: #101418;
    font: 11px / 17px var(--mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ag-box.is-in span {
    bottom: auto;
    top: 6px;
    left: 6px;
  }
  /* everything at once: the tag sits in its own box's corner, so it never covers a neighbour */
  .ag-box.is-all span {
    inset: -1px -1px auto auto;
    border-radius: 0 4px 0 4px;
    max-width: max(62%, 170px);
  }
  @keyframes ag-box {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  /* ---- the agent's cursor */
  .ag-cur {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    color: var(--text);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    will-change: transform;
  }
  .ag.is-run .ag-cur {
    opacity: 1;
  }
  .ag.is-rest .ag-cur {
    opacity: 0.55;
  }
  .ag-cur svg {
    display: block;
    margin: -3px 0 0 -4px;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.35));
    transition: transform 0.12s;
  }
  .ag-cur.is-down svg {
    transform: scale(0.82);
  }
  .ag-cur span {
    position: absolute;
    left: 14px;
    top: 16px;
    padding: 0 6px;
    border-radius: 3px 8px 8px 8px;
    background: var(--fonte);
    color: #101418;
    font-size: 11px;
    line-height: 17px;
  }
  .ag-cur i {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--fonte);
    border-radius: 50%;
    opacity: 0;
  }
  .ag-cur.is-click i {
    animation: ag-ring 0.5s ease-out;
  }
  @keyframes ag-ring {
    from {
      opacity: 0.9;
      transform: scale(0.3);
    }
    to {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @media (max-width: 899px) {
    .ag-grid {
      display: flex;
      flex-direction: column;
    }
    .ag-left {
      display: contents;
    }
    .ag .label {
      order: 0;
      margin-bottom: 20px;
    }
    .ag-right {
      display: contents;
    }
    .ag-stage {
      order: 1;
    }
    .ag-list {
      order: 2;
    }
    .ag-info {
      order: 3;
    }
    .ag-desk {
      order: 4;
    }
    .ag-stage {
      flex: none;
      width: calc(100% + 2 * var(--gutter));
      max-height: none;
      margin-inline: calc(var(--gutter) * -1);
      border-radius: 0;
    }
    /* the projects become one row of names; the line is in the panel above */
    .ag-list {
      display: flex;
      gap: 0 18px;
      flex-wrap: wrap;
      align-items: baseline;
      margin-top: 6px;
    }
    .ag-tier {
      padding: 0;
    }
    .ag-row,
    .ag-row.is-tool {
      display: block;
      width: auto;
      padding: 12px 0;
    }
    .ag-row .ag-n,
    .ag-row .ag-line {
      display: none;
    }
    .ag-row .ag-name,
    .ag-row.is-tool .ag-name {
      font-size: 18px;
      line-height: 24px;
    }
    .ag-row i {
      inset: auto 0 6px 0;
      background: none;
    }
    .ag-info {
      margin-top: 12px;
    }
    .ag-pan {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }
    .ag-sub {
      font-size: 14px;
      line-height: 21px;
    }
    .ag-desk {
      margin-top: 24px;
    }
    .ag-log {
      height: 54px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ag-desk .ag-status,
    .ag-log {
      display: none;
    }
    .ag-pan,
    .ag-pan.is-on {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Event-driven: no animation-frame loop. The cursor moves with Web Animations; the run is an async sequence.
  type P = { id: string; name: string; ground: string; film: { prev: string; full: string; dur: number } | null };
  const root = document.querySelector<HTMLElement>('[data-ag]')!;
  const D: P[] = JSON.parse(document.getElementById('ag-data')!.textContent!);
  const CLOCK = (document.getElementById('ag-clock') as HTMLTemplateElement).content.textContent!.split(',');
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const stage = $('.ag-stage'), video = $<HTMLVideoElement>('video'), poster = $<HTMLImageElement>('.ag-poster');
  const rows = [...root.querySelectorAll<HTMLButtonElement>('.ag-row')];
  const pans = [...root.querySelectorAll<HTMLElement>('.ag-pan')];
  const wins = [...root.querySelectorAll<HTMLElement>('.ag-window')];
  const cur = $('.ag-cur'), ax = $('.ag-ax'), log = $('.ag-log');
  const hand = $<HTMLButtonElement>('.ag-hand'), see = $<HTMLButtonElement>('.ag-see'), who = $('.ag-who-t');
  const soundB = $<HTMLButtonElement>('.ag-sound'), hit = $<HTMLButtonElement>('.ag-hit');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const SCALE = [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }];
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  let at = 0, visible = false, held = false, sound = false, started = false;
  let agent = !reduced, run = 0, seeing = false;
  let bar: Animation | null = null, token = 0;

  // ---- the stage (the same for the agent and the visitor)
  const big = () => !saveData && stage.clientWidth * Math.min(devicePixelRatio, 2) >= 1500;
  const src = (d: P) => (sound || big() ? d.film!.full : d.film!.prev);
  const sync = () => {
    if (!bar || !D[at].film || !Number.isFinite(video.duration) || !video.duration) return;
    bar.effect!.updateTiming({ duration: video.duration * 1000 });
    bar.currentTime = video.currentTime * 1000;
    if (video.paused || video.seeking || video.readyState < 3) bar.pause(); else bar.play();
  };
  for (const ev of ['playing', 'pause', 'seeked', 'seeking', 'waiting', 'loadedmetadata']) video.addEventListener(ev, sync, { passive: true });
  video.addEventListener('playing', () => stage.classList.add('is-live'), { passive: true });

  function apply() {
    if (!started) return;
    const want = visible && !held && !document.hidden;
    stage.classList.toggle('is-paused', held);
    hit.setAttribute('aria-label', held ? 'Play' : 'Pause');
    video.loop = !agent;
    if (!D[at].film) return;
    if (!want) video.pause();
    else if (video.paused && !video.ended) void video.play().catch(() => { if (!video.muted) { setSound(false, false); void video.play().catch(() => {}); } });
  }
  function load(d: P, t: number) {
    const k = ++token;
    video.src = src(d);
    video.muted = !sound;
    if (t > 0) video.addEventListener('loadedmetadata', () => { if (k === token) video.currentTime = t; }, { once: true });
  }
  function select(i: number) {
    at = (i + D.length) % D.length;
    started = true;
    const d = D[at];
    rows.forEach((r, k) => { r.classList.toggle('is-on', k === at); r.setAttribute('aria-pressed', String(k === at)); });
    pans.forEach((p, k) => { p.classList.toggle('is-on', k === at); p.inert = k !== at; });
    for (const w of wins) w.classList.toggle('is-on', w.dataset.id === d.id);
    stage.dataset.kind = d.film ? 'film' : 'window';
    stage.classList.remove('is-live');
    if (d.ground) stage.style.setProperty('--ground', d.ground);
    bar?.cancel();
    bar = null;
    held = false;
    if (d.film) {
      bar = rows[at].querySelector('b')!.animate(SCALE, { duration: d.film.dur * 1000, iterations: agent ? 1 : Infinity, fill: 'both' });
      bar.pause();
      video.setAttribute('aria-label', `${d.name} film`);
      poster.srcset = `/media/${d.id}-640.webp 640w, /media/${d.id}-1280.webp 1280w`;
      poster.src = `/media/${d.id}-1280.webp`;
      load(d, 0);
    } else {
      video.pause();
      video.removeAttribute('src');
      video.load();
    }
    apply();
    if (seeing) setTimeout(drawAll, 60);
  }
  function setSound(on: boolean, swap = true) {
    sound = on;
    soundB.setAttribute('aria-pressed', String(on));
    soundB.textContent = on ? 'Sound on' : 'Sound off';
    video.muted = !on;
    const d = D[at];
    if (on && swap && d.film && !video.src.endsWith(d.film.full)) load(d, video.currentTime);
  }
  soundB.addEventListener('click', () => { setSound(!sound); if (sound) held = false; apply(); });
  hit.addEventListener('click', () => { held = !held; if (!held && video.ended) video.currentTime = 0; apply(); });
  $('.ag-fs').addEventListener('click', () => {
    const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
    if (document.fullscreenElement) void document.exitFullscreen();
    else if (stage.requestFullscreen) void stage.requestFullscreen();
    else v.webkitEnterFullscreen?.();
  });
  document.addEventListener('fullscreenchange', () => document.dispatchEvent(new CustomEvent('px:viewer', { detail: { open: !!document.fullscreenElement } })));

  // ---- what an agent reads from an element: its role and its accessible name, both from the DOM
  const ROLE: Record<string, string> = { BUTTON: 'button', A: 'link', H2: 'heading', H3: 'heading', P: 'paragraph', VIDEO: 'video', OL: 'list', SECTION: 'region' };
  const read = (el: Element) => {
    const role = el.getAttribute('role') ?? ROLE[el.tagName] ?? el.tagName.toLowerCase();
    const by = el.getAttribute('aria-labelledby');
    let name = el.getAttribute('aria-label') ?? (by ? document.getElementById(by)?.textContent : null) ?? (el.tagName === 'H3' ? el.firstChild?.textContent : el.textContent) ?? '';
    name = name.replace(/\s+/g, ' ').trim();
    return { role, name: name.length > 46 ? `${name.slice(0, 45)}…` : name };
  };
  const place = (el: Element) => {
    const r = el.getBoundingClientRect(), s = root.getBoundingClientRect();
    return { x: r.left - s.left, y: r.top - s.top, w: r.width, h: r.height };
  };
  function box(el: Element, pad = 6) {
    const p = place(el), { role, name } = read(el);
    const b = document.createElement('div');
    b.className = 'ag-box';
    if (p.y - pad < 24 || el === video) b.classList.add('is-in');
    const inset = el === video ? 0 : pad;
    b.style.cssText = `left:${p.x - inset}px;top:${p.y - inset}px;width:${p.w + inset * 2}px;height:${p.h + inset * 2}px`;
    const t = document.createElement('span');
    t.textContent = name ? `${role} · ${name}` : role;
    b.append(t);
    ax.append(b);
    return b;
  }
  const fade = (b: HTMLElement) => { b.classList.add('is-out'); setTimeout(() => b.remove(), 400); };
  const clearBoxes = () => { for (const b of [...ax.children]) fade(b as HTMLElement); };
  // everything it can read or use in the section, at once
  const targets = () => [
    ...rows,
    D[at].film ? video : root.querySelector('.ag-window.is-on p')!,
    ...(D[at].film ? [soundB] : []),
    ...root.querySelectorAll('.ag-pan.is-on :is(h3, a)'),
  ];
  function drawAll() {
    ax.replaceChildren();
    if (!seeing) return;
    targets().forEach((el, k) => { const b = box(el, 4); b.classList.add('is-all'); b.style.animationDelay = `${k * 35}ms`; });
  }
  see.addEventListener('click', () => {
    seeing = !seeing;
    see.setAttribute('aria-pressed', String(seeing));
    if (seeing) { say('read', `${read(root).role} "${read(root).name}" · ${targets().length} elements`); drawAll(); } else clearBoxes();
  });
  new ResizeObserver(() => { if (seeing) drawAll(); }).observe(root);

  // ---- the log: only what happens on this page
  function say(verb: string, what: string) {
    const li = document.createElement('li');
    const b = document.createElement('b');
    b.textContent = verb;
    const s = document.createElement('span');
    s.textContent = what;
    li.append(b, s);
    log.append(li);
    while (log.children.length > 6) log.firstElementChild!.remove();
  }

  // ---- the cursor
  let cx = 0, cy = 0;
  const set = (x: number, y: number) => { cx = x; cy = y; cur.style.transform = `translate(${x}px, ${y}px)`; };
  async function move(x: number, y: number) {
    const dx = x - cx, dy = y - cy, dist = Math.hypot(dx, dy);
    if (dist < 2) return;
    // a slight arc, as a hand would draw it
    const bend = Math.min(60, dist * 0.16), mx = (cx + x) / 2 - (dy / dist) * bend, my = (cy + y) / 2 + (dx / dist) * bend;
    const frames = Array.from({ length: 13 }, (_, k) => {
      const t = k / 12, u = 1 - t;
      return { transform: `translate(${u * u * cx + 2 * u * t * mx + t * t * x}px, ${u * u * cy + 2 * u * t * my + t * t * y}px)` };
    });
    const a = cur.animate(frames, { duration: Math.min(1100, 380 + dist * 0.9), easing: 'cubic-bezier(0.45, 0, 0.15, 1)', fill: 'forwards' });
    await a.finished.catch(() => {});
    set(x, y);
    a.cancel();
  }
  const onto = (el: Element, fx = 0.5, fy = 0.5) => { const p = place(el); return move(p.x + p.w * fx, p.y + p.h * fy); };
  async function press() {
    cur.classList.add('is-down');
    await sleep(110);
    cur.classList.remove('is-down');
    cur.classList.remove('is-click');
    void cur.offsetWidth;
    cur.classList.add('is-click');
  }

  // ---- control
  const gate = async (id: number) => { while (id === run && (!visible || document.hidden)) await sleep(250); return id === run; };
  function status() {
    root.classList.toggle('is-you', !agent);
    root.classList.toggle('is-run', agent);
    who.textContent = root.classList.contains('is-done') ? 'Agent finished' : agent ? 'Agent has control' : 'You have control';
    hand.textContent = root.classList.contains('is-done') ? 'Run again' : agent ? 'Take over' : 'Hand back';
  }
  function takeOver() {
    if (!agent) return;
    agent = false;
    run++;
    root.classList.remove('is-rest', 'is-done');
    if (!seeing) clearBoxes();
    say('yield', 'you have control');
    video.loop = true;
    bar?.effect?.updateTiming({ iterations: Infinity });
    status();
  }
  function handBack(from: number) {
    agent = true;
    root.classList.remove('is-done');
    status();
    void go(from);
  }
  hand.addEventListener('click', () => {
    if (agent && !root.classList.contains('is-done')) takeOver();
    else handBack(root.classList.contains('is-done') ? 0 : at + 1);
  });
  rows.forEach((r, k) => r.addEventListener('click', (e) => { if (e.isTrusted) { takeOver(); select(k); } }));
  rows.forEach((r) => r.addEventListener('keydown', () => takeOver()));

  // ---- the run: read the section, then each project: find it, press it, watch it
  async function go(from: number) {
    const id = ++run;
    const ok = () => id === run;
    if (!(await gate(id))) return;
    if (!cx && !cy) { const p = place(rows[0]); set(p.x + p.w + 40, p.y - 60); }
    if (from === 0) {
      const l = root.querySelector('.ag-list')!;
      say('read', `${read(l).role} "${read(l).name}" · ${rows.length} items`);
      const b = seeing ? null : box(l, 8);
      await sleep(900);
      if (b) fade(b);
      if (!ok()) return;
    }
    for (let i = from; i < D.length; i++) {
      if (!(await gate(id))) return;
      const d = D[i], row = rows[i];
      root.classList.remove('is-rest');
      await onto(row, Math.min(0.5, 120 / row.clientWidth), 0.5);
      if (!ok()) return;
      const b = seeing ? null : box(row);
      await sleep(420);
      if (!ok()) { if (b) fade(b); return; }
      await press();
      row.classList.add('is-press');
      setTimeout(() => row.classList.remove('is-press'), 160);
      say('click', `button "${d.name}"`);
      select(i);
      await sleep(380);
      if (b) fade(b);
      if (!ok()) return;
      // then it turns to what opened
      const what = d.film ? video : root.querySelector('.ag-window.is-on p')!;
      await onto(stage, 0.08, 0.86);
      if (!ok()) return;
      const w = seeing ? null : box(what);
      say(d.film ? 'watch' : 'read', d.film ? `video "${read(video).name}" ${CLOCK[i]}` : `paragraph "${read(what).name}"`);
      await sleep(900);
      if (w) fade(w);
      root.classList.add('is-rest');
      if (d.film) {
        await new Promise<void>((res) => {
          const done = () => { video.removeEventListener('ended', done); clearInterval(poll); res(); };
          const poll = setInterval(() => { if (!ok()) done(); }, 300);
          video.addEventListener('ended', done);
        });
      } else await sleep(6500);
      if (!ok()) return;
    }
    root.classList.remove('is-rest');
    root.classList.add('is-done');
    say('done', `${D.length} projects`);
    const p = place(hand);
    await move(p.x - 18, p.y + p.h / 2);
    status();
  }

  // nothing loads until the stage is near; the agent starts when the section is on screen
  const near = new IntersectionObserver((es) => {
    if (!es.some((e) => e.isIntersecting)) return;
    near.disconnect();
    select(0);
    status();
    if (agent) void go(0);
  }, { rootMargin: '30% 0px' });
  near.observe(stage);
  new IntersectionObserver(([e]) => { visible = e.intersectionRatio >= 0.5; apply(); }, { threshold: [0, 0.5, 1] }).observe(stage);
  document.addEventListener('visibilitychange', apply);
</script>
