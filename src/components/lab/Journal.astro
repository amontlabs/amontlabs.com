<script>
  const root = document.querySelector<HTMLElement>('[data-jr]')!;
  // The data is as old as the last sync; say so in the reader's own time, and name the days from their side of midnight.
  const t = root.querySelector('time')!;
  const mins = Math.max(0, Math.round((Date.now() - new Date(root.dataset.synced!).getTime()) / 60000));
  t.textContent = mins < 1 ? 'just now' : mins < 60 ? `${mins} min ago` : mins < 1440 ? `${Math.round(mins / 60)} h ago` : `${Math.round(mins / 1440)} d ago`;
  const paris = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
  const today = paris.format(new Date()), yesterday = paris.format(new Date(Date.now() - 864e5));
  const arts = [...root.querySelectorAll<HTMLElement>('.jr-stack article')].reverse(); // oldest first
  for (const a of arts) {
    if (a.dataset.day === today) a.dataset.label = 'Today, so far';
    else if (a.dataset.day === yesterday) a.dataset.label = 'Yesterday';
  }
  const days = Number(getComputedStyle(root).getPropertyValue('--days'));
  const ends = [...root.querySelectorAll<HTMLElement>('.jr-end')];
  for (const e of ends) if (e.dataset.last === today) e.textContent = 'Today';
  new IntersectionObserver((es, io) => es[0].isIntersecting && (root.classList.add('is-in'), io.disconnect()), { threshold: 0.15 }).observe(root);

  // ---- days: across the strips. Pointing previews a day, choosing one keeps it.
  const title = root.querySelector('.jr-nav h3')!;
  const marks = [...root.querySelectorAll<HTMLElement>('.jr-mark')];
  const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.jr-nav button');
  const byIndex = new Map(arts.map((a) => [Number(a.dataset.i), a]));
  let kept = arts.findIndex((a) => a.classList.contains('is-on'));
  const totals = [...root.querySelectorAll<HTMLElement>('.jr-rowline')].map((r) => [r.querySelector<HTMLElement>('.jr-total')!, r.querySelector<HTMLElement>('.jr-strip')!.dataset.daily!.split(',')] as const);
  const show = (n: number, keep: boolean, pointing = false) => {
    const art = arts[n];
    if (!art) return;
    if (keep) kept = n;
    for (const a of arts) {
      a.classList.toggle('is-on', a === art);
      a.inert = a !== art;
    }
    title.textContent = art.dataset.label!;
    const i = Number(arts[kept].dataset.i);
    root.style.setProperty('--sel', String(i));
    const viewing = art !== arts[kept];
    root.classList.toggle('has-view', viewing);
    if (viewing) root.style.setProperty('--view', art.dataset.i!);
    // the date under the chosen column; near an end it takes that end's place
    for (const mark of marks) {
      mark.textContent = arts[kept].dataset.label!.replace(/, so far$/, '').replace(/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) /, '');
      mark.classList.toggle('at-start', i < 3);
      mark.classList.toggle('at-end', i > days - 4);
    }
    for (const e of ends) e.classList.toggle('is-off', e.dataset.last ? i > days - 7 : i < 6);
    // pointing at a day: each row's total gives way to that day's commits
    const di = viewing || pointing ? Number(art.dataset.i) : -1; // also when the day pointed at is the chosen one
    for (const [el, daily] of totals) {
      el.textContent = di < 0 ? el.dataset.total! : daily[di];
      el.classList.toggle('is-day', di >= 0);
    }
    prev.disabled = kept <= 0;
    next.disabled = kept >= arts.length - 1;
  };
  // the day under the pointer: the strips share one axis, so only x matters
  const dayAt = (e: PointerEvent | MouseEvent) => {
    const strip = (e.target as Element).closest('.jr-strip');
    if (!strip) return -1;
    const r = strip.getBoundingClientRect();
    const a = byIndex.get(Math.max(0, Math.min(days - 1, Math.floor(((e.clientX - r.left) / r.width) * days))));
    return a ? arts.indexOf(a) : -1;
  };
  const rows = root.querySelector<HTMLElement>('.jr-rows')!;
  rows.addEventListener('pointermove', (e) => {
    const n = dayAt(e);
    if (e.pointerType === 'mouse') show(n < 0 ? kept : n, false, n >= 0);
    else if (n >= 0 && n !== kept) show(n, true); // a finger dragged along a strip scrubs through the days
  });
  rows.addEventListener('pointerleave', () => show(kept, false));
  rows.addEventListener('click', (e) => {
    const n = dayAt(e);
    if (n >= 0) show(n, true, (e as PointerEvent).pointerType === 'mouse');
  });
  prev.addEventListener('click', () => show(kept - 1, true));
  next.addEventListener('click', () => show(kept + 1, true));
  root.querySelector('.jr-nav')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k !== 'ArrowLeft' && k !== 'ArrowRight') return;
    e.preventDefault();
    show(kept + (k === 'ArrowLeft' ? -1 : 1), true);
  });
  show(kept, true);

  // ---- projects: a row's name, or a project named in a summary, opens it in place. One at a time.
  const its = [...root.querySelectorAll<HTMLElement>('.jr-item')];
  let open: string | null = null;
  // the river takes the colour of the project pointed at, else of the one that is open, else its own
  const tint = (id: string | null) => {
    const it = its.find((x) => x.dataset.r === id);
    const hex = it && getComputedStyle(it).getPropertyValue('--c').trim().match(/^#([0-9a-f]{6})$/i)?.[1];
    const color = hex ? [0, 2, 4].map((k) => Number.parseInt(hex.slice(k, k + 2), 16) / 255) : null;
    (window as unknown as { __tint: number[] | null }).__tint = color; // the scene mounts late: it reads this when it does
    document.dispatchEvent(new CustomEvent('px:tint', { detail: { color } }));
  };
  const set = (id: string | null, reveal = false) => {
    open = id;
    rows.classList.toggle('has-open', !!id);
    for (const tab of root.querySelectorAll<HTMLElement>('[data-tab]')) tab.setAttribute('aria-pressed', String(tab.dataset.tab === id));
    for (const it of its) {
      const on = it.dataset.r === id;
      it.classList.toggle('is-open', on);
      it.querySelector('.jr-who')!.setAttribute('aria-expanded', String(on));
      const film = it.querySelector('video');
      if (!film) continue;
      if (on) {
        if (!film.src) film.src = film.dataset.src!;
        film.play().catch(() => {});
      } else {
        film.pause();
        // back to the silent loop for the next time it opens
        if (film.controls) {
          film.controls = false;
          film.muted = film.loop = true;
          film.src = film.dataset.src!;
          it.querySelector<HTMLElement>('.jr-sound')!.hidden = false;
        }
      }
    }
    tint(id);
    history.replaceState(null, '', id ? `#${id}` : location.pathname + location.search);
    // opened from a summary: bring the row into view once it has its height
    if (id && reveal) setTimeout(() => its.find((x) => x.dataset.r === id)!.scrollIntoView({ block: 'nearest', behavior: 'smooth' }), 440);
  };
  root.addEventListener('click', (e) => {
    const el = e.target as Element;
    const o = el.closest<HTMLElement>('[data-open]');
    if (o) {
      e.preventDefault();
      const row = o.classList.contains('jr-who') || o.classList.contains('jr-tog');
      set(row && o.dataset.open === open ? null : o.dataset.open!, true);
      return;
    }
    if (el.closest('[data-close]')) return set(null);
    const g = el.closest<HTMLElement>('[data-goto]');
    if (g) {
      show(arts.findIndex((a) => a.dataset.day === g.dataset.goto), true);
      root.querySelector('.jr-lead')!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      return;
    }
    const sound = el.closest<HTMLElement>('.jr-sound');
    if (sound) {
      const film = sound.parentElement!.querySelector('video')!;
      film.src = film.dataset.full!;
      film.muted = film.loop = false;
      film.controls = true;
      film.play().catch(() => {});
      sound.hidden = true;
    }
  });
  root.addEventListener('keydown', (e) => e.key === 'Escape' && open && set(null));
  for (const it of its) {
    const who = it.querySelector<HTMLElement>('.jr-who')!;
    who.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && tint(it.dataset.r!));
    who.addEventListener('pointerleave', () => tint(open));
  }
  document.addEventListener('themechange', () => requestAnimationFrame(() => tint(open)));
  const fromHash = () => {
    const wanted = location.hash.slice(1);
    if (wanted !== open && its.some((x) => x.dataset.r === wanted)) set(wanted, true);
  };
  addEventListener('hashchange', fromHash);
  fromHash();
</script>
