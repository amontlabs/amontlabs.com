---
// Tags and the stats row of one project (kind and platforms, latest release, stars, forks), compact and wrapping.
import { type Item, count, day, runsOn, stats } from "../../data/items";
import Icon from "../Icon.astro";

interface Props {
  it: Item;
  tags?: boolean;
}
const { it, tags = true } = Astro.props;
const s = stats(it.id);
---

{tags && <p class="px-tags mono lf-tags">{it.tags.map((t) => <span>{t}</span>)}{it.needs.map((t) => <span class="is-need">{t}</span>)}</p>}
<p class="lf mono">
  <span class="lf-run" title={runsOn(it)}><Icon name={it.kind} />{it.platforms.map((o) => <Icon name={o} />)}<span class="sr-only">{runsOn(it)}</span></span>
  {s?.version && <span title="Latest release">{s.version}<em>{day(s.releasedAt!)}</em></span>}
  {s && <span class="lf-n" title={`${s.stars} stars`}><Icon name="star" size={12} />{count(s.stars)}<span class="sr-only"> stars</span></span>}
  {s && <span class="lf-n" title={`${s.forks} forks`}><Icon name="fork" size={12} />{count(s.forks)}<span class="sr-only"> forks</span></span>}
</p>

<style>
  .lf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
  }
  .lf :global(.icon) {
    flex: none;
    color: var(--secondary);
  }
  .lf-run,
  .lf-n {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .lf em {
    margin-left: 8px;
    font-style: normal;
    color: var(--secondary);
  }
</style>
