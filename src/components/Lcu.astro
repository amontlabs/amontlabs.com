---
import data from "../data/lcu.json";

const STARS_MIN = 100; // show stars only from this count up
const released = new Date(data.releasedAt);
const date = Number.isNaN(released.getTime())
  ? null
  : new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Paris" }).format(released);
const stars =
  data.stars >= 1000 ? `${(Math.floor(data.stars / 100) / 10).toFixed(1).replace(/\.0$/, "")}k stars` : `${data.stars} stars`;
const release = [data.version, date, data.stars >= STARS_MIN ? stars : null].filter(Boolean).join(" · ");
---

<section class="block exhibit-next" aria-label="LCU">
  <div class="wrap grid">
    <p class="silo-name lcu-name" aria-hidden="true">LCU</p>

    <div class="placard lcu-placard">
      <div class="placard-top">
        <h3 class="silo-head">Codex computer use, decoupled from the Codex app.</h3>
        <p>Gives Claude Code, Codex CLI and Pi the computer-use runtime from the ChatGPT desktop app on your machine, with no Codex sign-in.</p>
      </div>
      <div>
        <p class="mono dim meta">
          <span>macOS · Linux · Open source (MIT)</span>
          <span>{release}</span>
        </p>
        <p class="silo-links">
          <a class="link is-link" href="https://lcu.amontlabs.com">lcu.amontlabs.com ↗</a>
          <a class="link is-link" href="https://github.com/amontlabs/lcu">Source ↗</a>
        </p>
      </div>
    </div>
  </div>
</section>
