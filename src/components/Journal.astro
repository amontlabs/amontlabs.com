---
// Prototype F, "Activity": the projects and what is happening in them, as one panel.
//   the day       one summary of one day (today first), with the projects that moved and what was released
//   the projects  one row each, in the site's order: what it is, and its own 30 days as a strip of bars on a shared
//                 time axis. The rows are both the list of projects and the chart.
// Two gestures, one per axis: across (the strips) picks a day, so pointing previews it and a click keeps it;
// a row's name opens that project in place (film, what it is, where to get it, what was said about it lately).
// Every day's entry is in the page and stacked in one grid cell, so switching days moves nothing.
// Data: src/data/activity.json (scripts/update-activity-data.mjs). Same-origin and static: the page asks GitHub nothing.
import activity from "../data/activity.json";
import Icon from "./Icon.astro";
import { clock, count, items, KIND, OS, others, STAGES } from "../data/items";

type Entry = { day: string; text?: string; repos: { repo: string; n: number; merged: number }[]; releases: { repo: string; to: string; from: string | null; n: number; url: string }[]; highlights: { repo: string; text: string; url: string }[] };
type Repo = { name: string; about: string; explain?: { lead: string; points: string[] }; stars: number; forks: number; license: string | null; created: string | null; languages: { name: string; share: number }[]; latest: { tag: string; at: string; url: string } | null; weeks: { w: string; n: number }[]; shipped: string[]; daily: number[]; commits: number; merged: number; releases: number };
const A = activity as unknown as { days: string[]; repos: Record<string, Repo>; totals: { commits: number; merged: number; outside?: number; issues?: number; releases: number }; journal: Entry[]; updatedAt: string };
const nf = new Intl.NumberFormat("en-GB");
const dfmt = new Intl.DateTimeFormat("en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
const label = (d: string) => dfmt.format(new Date(`${d}T12:00:00Z`));
const short = (d: string) => label(d).replace(/^\w+ /, "");
// the day as a calendar leaf: month, number, weekday (the script swaps the weekday for "Yesterday" or "So far today")
const leaf = (d: string) => label(d).split(" ") as [string, string, string];
const gh = (repo: string) => `https://github.com/amontlabs/${repo}`;
const N = A.days.length;

// colour follows the project, never its rank. A repository not listed here is grey.
const ORDER = ["silo", "fjord", "sic", "lcu", "lastdrop", "hartlib"];
const color = (id: string) => (ORDER.includes(id) ? `var(--c${ORDER.indexOf(id) + 1})` : "var(--c0)");
const name = (id: string) => A.repos[id]?.name ?? id;
// the rows: the featured projects (ORDER), the busiest first. Any other repository that moved is not a row, so a
// new repository never grows the panel: it is listed under "More" (a menu in the axis line) and opens like a row.
// Every repository still counts in the totals, the summaries, and the tabs and chips of an open project.
const busiest = (a: string, b: string) => A.repos[b].commits - A.repos[a].commits;
const featured = Object.keys(A.repos).filter((id) => ORDER.includes(id)).sort(busiest);
const extra = Object.keys(A.repos).filter((id) => !ORDER.includes(id)).sort(busiest);
const ids = [...featured, ...extra];
const item = (id: string) => items.find((it) => it.id === id);
// what a repository is, in one row: the site's wording, else the first sentence of its GitHub description
const about = (id: string) => A.repos[id].about.replace(/^\[WIP\]\s*/, "");
const lineOf = (id: string) => item(id)?.line ?? others[id]?.line ?? (about(id).match(/^.*?[.!?](?=\s|$)/)?.[0] || about(id));

// one scale for every row, so a quiet project looks quiet next to a busy one. A burst day would flatten the rest:
// the scale stops at twice the typical busy day, and a bar past it is drawn full height with a break near its top.
// The scale is set by the rows alone: a repository under "More" never changes how they are drawn.
const busy = featured.flatMap((id) => A.repos[id].daily.filter((n) => n > 0)).sort((a, b) => a - b);
const peak = Math.max(1, Math.min(busy.at(-1) ?? 1, (busy[Math.floor(busy.length * 0.75)] ?? 1) * 2));
const burst = (n: number) => n > peak * 1.25;

const entry = (d: string) => A.journal.find((e) => e.day === d);
const first = A.journal[0]?.day;
const released = (id: string, d: string) => entry(d)?.releases.some((r) => r.repo === id);
const sinceFmt = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "Europe/Paris" });
const monthYear = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric", timeZone: "Europe/Paris" });
const dayMonth = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "Europe/Paris" });
// a project named in a summary opens it
const names = ids.map((id) => ({ id, name: name(id) })).sort((a, b) => b.name.length - a.name.length);
const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const re = new RegExp(`\\b(${names.map((n) => esc(n.name)).join("|")})\\b`, "g");
const parts = (text: string) => text.split(re).map((t) => ({ t, id: names.find((n) => n.name === t)?.id }));
---

<section class="block jr" aria-labelledby="jr-h" data-jr data-synced={A.updatedAt} style={`--days: ${N}; --sel: ${A.days.indexOf(first ?? "")}`}>
  <div class="wrap">
    <h1 class="jr-title">Practical, open-source software on emerging tech.</h1>
    <div class="jr-panel">
      <header class="jr-head">
        <h2 id="jr-h" class="sr-only">Activity</h2>
        <dl class="jr-nums">
          <div><dd>{nf.format(A.totals.commits)}</dd><dt>commits</dt></div>
          <div><dd>{nf.format(A.totals.merged)}</dd><dt>PRs merged{A.totals.outside ? <span class="jr-contrib"> · {nf.format(A.totals.outside)} from contributors</span> : ""}</dt></div>
          <div><dd>{nf.format(A.totals.issues ?? 0)}</dd><dt>issues closed</dt></div>
          <div><dd>{nf.format(A.totals.releases)}</dd><dt>releases</dt></div>
          <div class="mono dim"><dt>in the last 30 days</dt></div>
        </dl>
        <p class="mono dim"><span class="jr-cap">Last 30 days{A.totals.outside ? ` · ${nf.format(A.totals.outside)} PRs from contributors` : ""}</span><a href="https://github.com/amontlabs"><Icon name="github" size={13} />amontlabs</a><span><span class="jr-upd">Updated </span><time datetime={A.updatedAt}>{new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Paris" }).format(new Date(A.updatedAt))}</time></span></p>
      </header>

      <div class="jr-lead">
        <div class="jr-nav">
          <h3 aria-live="polite">
            <span class="jr-dl">{first && label(first)}</span>
            {first && (
              <span class="jr-leaf" aria-hidden="true">
                <span class="jr-lm mono">{leaf(first)[2]}</span>
                <span class="jr-ln">{leaf(first)[1]}</span>
                <span class="jr-lw mono">{leaf(first)[0]}</span>
              </span>
            )}
          </h3>
          <button type="button" class="jr-daymore" aria-expanded="false" aria-label="The whole day"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <div>
            <button type="button" data-step="-1" aria-label="Earlier day"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            <button type="button" data-step="1" aria-label="Later day"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          </div>
        </div>
        <div class="jr-stack">
          {A.journal.map((e) => (
            <article data-day={e.day} data-i={A.days.indexOf(e.day)} data-label={label(e.day)} data-full={label(e.day)} class:list={[e.day === first && "is-on"]} inert={e.day !== first}>
              {e.text ? (
                <p class="jr-text">{parts(e.text).map((p) => (p.id ? <a href={`#${p.id}`} data-open={p.id} style={`--c: ${color(p.id)}`}>{p.t}</a> : p.t))}</p>
              ) : (
                <ul class="jr-hl">{e.highlights.map((h) => <li><a href={h.url}><b>{name(h.repo)}</b> {h.text}</a></li>)}</ul>
              )}
              <ul class="jr-split">
                {e.repos.map((r) => (
                  <li>
                    <i style={`background: ${color(r.repo)}`} aria-hidden="true"></i>
                    <a href={`#${r.repo}`} data-open={r.repo}>{name(r.repo)}</a>
                    {r.n > 0 && <a class="mono dim" href={`${gh(r.repo)}/commits?since=${e.day}&until=${e.day}`}>{nf.format(r.n)} {r.n === 1 ? "commit" : "commits"}</a>}
                    {e.releases.filter((x) => x.repo === r.repo).map((x) => <a class="jr-rel mono" href={x.url}><span class="dim">Released</span> {x.from ? `${x.from} → ` : ""}{x.to}</a>)}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>

      <div class="jr-rows">
        <div class="jr-tabs">
          <div>
            <button type="button" class="jr-all" data-close><Icon name="back" size={14} />All projects</button>
            {ids.map((id) => <button type="button" data-open={id} data-tab={id} aria-pressed="false" style={`--c: ${color(id)}`}><i aria-hidden="true"></i>{name(id)}</button>)}
          </div>
        </div>
        {ids.map((id, row) => {
          const it = item(id);
          const R = A.repos[id];
          // how far along, on one ladder: the site's own word for its projects, GitHub's "[WIP]" for the others
          const stage = it?.stage ?? others[id]?.stage ?? (/^\[WIP\]/.test(R.about) ? "WIP" : null);
          const step = stage ? STAGES.indexOf(stage) + 1 : 0;
          const line = lineOf(id);
          const links = it ? it.links : [{ kind: "github", label: "GitHub", href: gh(id) }];
          // the settled, hand-written pitch; a repository without one falls back to a generated explanation
          const pitch = it?.pitch ?? others[id]?.pitch ?? R.explain;
          const what = it ?? others[id]; // what kind of thing it is and where it runs
          const kind = what ? [KIND[what.kind], what.platforms.map((p) => OS[p]).join(", ")].filter(Boolean).join(" · ") : null;
          const chips = [...(it ? [KIND[it.kind], ...it.platforms.map((p) => OS[p]), ...it.needs.map((n) => `Works with ${n}`)] : []), ...(R.license ? [`${R.license} licence`] : [])];
          const young = R.created && Date.now() - new Date(R.created).getTime() < 51 * 7 * 864e5;
          const since = young ? `Since ${sinceFmt.format(new Date(R.created!))}` : "Last 12 months";
          const life = R.weeks.reduce((a, w) => a + w.n, 0);
          return (
            <div class:list={["jr-item", row >= featured.length && "is-extra"]} id={id} data-r={id} style={`--c: ${color(id)}; --row: ${row}`}>
              <div class="jr-rowline">
                <h3>
                  <button type="button" class="jr-who" data-open={id} aria-expanded="false" aria-controls={`jr-more-${id}`}>
                    <i aria-hidden="true"></i>
                    <b>{R.name}</b>
                    <span class="jr-what">
                      <span class="jr-line" title={line}>{line}</span>
                      <span class:list={["jr-meta mono", !stage && !what && "is-bare"]}>
                        {!stage && <em></em>}
                        {stage && <em><span class="jr-ladder" aria-hidden="true">{STAGES.map((_, k) => <i class:list={[k < step && "is-on"]}></i>)}</span>{stage}</em>}
                        {what ? <span class="jr-kinds" role="img" aria-label={kind}><Icon name={what.kind} size={12} />{what.platforms.map((p) => <Icon name={p} size={12} />)}</span> : <span></span>}
                        <span class="jr-gh"><span aria-label={`${R.stars} stars`}><Icon name="star" size={11} />{count(R.stars)}</span>
                        <span aria-label={`${R.forks} forks`}><Icon name="fork" size={11} />{count(R.forks)}</span></span>
                      </span>
                    </span>
                  </button>
                </h3>
                <div class="jr-strip" aria-hidden="true" data-daily={R.daily.join(",")}>
                  {R.daily.map((n, i) => (
                    <span class:list={[burst(n) && "is-over"]} style={`--v: ${Math.min(1, n / peak).toFixed(3)}; --i: ${i}`}>
                      {released(id, A.days[i]) && <u></u>}
                      {n > 0 && <i></i>}
                    </span>
                  ))}
                </div>
                <span class="jr-total mono dim" data-total={nf.format(R.commits)} title={`${nf.format(R.commits)} commits in the last 30 days`} aria-label={`${nf.format(R.commits)} commits in the last 30 days`}><Icon name="commit" size={12} /><span class="jr-num">{nf.format(R.commits)}</span></span>
                <button type="button" class="jr-tog" data-open={id} tabindex="-1" aria-hidden="true"><svg class="jr-chev" viewBox="0 0 16 16" width="16" height="16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
              </div>
              <div class="jr-axis jr-axis-in mono dim" aria-hidden="true">
                <span></span>
                <div><span class="jr-end">{short(A.days[0])}</span><b class="jr-mark"></b><span class="jr-end" data-last={A.days.at(-1)}>{short(A.days.at(-1)!)}</span></div>
                <span><i class="jr-key"></i>Release</span>
              </div>
              <div class="jr-more" id={`jr-more-${id}`} role="region" aria-label={R.name}>
                <div class="jr-more-in">
                  {/* phones: the project is a sheet over the screen; its head switches projects and closes it */}
                  <div class="jr-sheethead">
                    <i class="jr-grab" aria-hidden="true"></i>
                    <nav class="jr-chips2" aria-label="Projects">
                      {ids.map((o) => <button type="button" data-open={o} aria-current={o === id ? "true" : undefined} style={`--c: ${color(o)}`}><i aria-hidden="true"></i>{name(o)}</button>)}
                    </nav>
                    <button type="button" class="jr-x" data-close aria-label="Close"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button>
                  </div>
                  <div class:list={["jr-view", it?.film && "has-film"]}>
                    <div class="jr-sheettitle">
                      <p class="jr-sheetname" id={`jr-name-${id}`}><i aria-hidden="true"></i>{R.name}</p>
                      <p class="jr-sheetlinks">{links.map((l) => <a href={l.href} aria-label={l.kind === "github" ? `${R.name} on GitHub` : `${R.name} website (${l.label})`}><Icon name={l.kind === "github" ? "github" : "site"} size={18} /></a>)}</p>
                      {(pitch || it?.sub) && <p class="jr-sheetline">{line}</p>}
                    </div>
                    {it?.film && (
                      <div class="jr-film" style={`aspect-ratio: ${it.film.ratio}; --ar: ${it.film.ratio}`}>
                        <video muted loop playsinline disablepictureinpicture preload="none" poster={`/media/${it.film.id}-1280.webp`} data-src={`/media/${it.film.id}.mp4`} data-full={it.film.full}></video>
                        <button type="button" class="jr-sound mono"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor" /></svg>Watch with sound · {clock(it.film.dur)}</button>
                      </div>
                    )}
                    <div class="jr-about">
                      <p class="jr-sub">{pitch?.lead ?? it?.sub ?? about(id)}</p>
                      {pitch && <ul class="jr-points">{pitch.points.map((x) => <li>{x}</li>)}</ul>}
                      {it && it.needs.length > 0 && <p class="jr-needs mono dim"><Icon name="link" size={12} />Works with {it.needs.join(", ")}</p>}
                    </div>
                    <div class="jr-acts">
                      <p class="jr-links">{links.map((l) => <a href={l.href}><Icon name={l.kind === "github" ? "github" : "site"} size={14} />{l.label}</a>)}</p>
                    </div>
                    <div class:list={["jr-profile", !stage && "is-bare"]}>
                      {stage && (
                        <section class="p-stage">
                          <div class="jr-stagehead">
                            <h4 class="mono dim">Stage</h4>
                            {what && (
                              <ul class="jr-chips mono">
                                <li><Icon name={what.kind} size={12} />{KIND[what.kind]}</li>
                                {what.platforms.map((p) => <li><Icon name={p} size={12} />{OS[p]}</li>)}
                              </ul>
                            )}
                          </div>
                          <ol class="jr-stage">
                            {STAGES.map((x, k) => <li class:list={[k + 1 <= step && "is-done", k + 1 === step && "is-now"]} aria-current={k + 1 === step ? "step" : undefined}>{x}</li>)}
                          </ol>
                        </section>
                      )}
                      <section class="p-days">
                        <h4 class="mono dim">Last 30 days</h4>
                        <ul class="jr-figs">
                          <li><Icon name="commit" size={13} /><b>{nf.format(R.commits)}</b>commits</li>
                          <li><Icon name="merge" size={13} /><b>{nf.format(R.merged)}</b>merged</li>
                          <li><Icon name="tag" size={13} /><b>{nf.format(R.releases)}</b>{R.releases === 1 ? "release" : "releases"}</li>
                        </ul>
                      </section>
                      <section class="p-life">
                        <h4 class="mono dim">{since}</h4>
                        <ul class="jr-figs">
                          <li><Icon name="commit" size={13} /><b>{nf.format(life)}</b>commits</li>
                          <li><Icon name="tag" size={13} /><b>{nf.format(R.shipped.length)}</b>{R.shipped.length === 1 ? "release" : "releases"}</li>
                          {R.latest && <li><a href={R.latest.url}><b>{R.latest.tag}</b>{dayMonth.format(new Date(R.latest.at))}</a></li>}
                        </ul>
                      </section>
                      <section class="p-github">
                        <h4 class="mono dim">On GitHub</h4>
                        <ul class="jr-figs">
                          <li><Icon name="star" size={13} /><b>{nf.format(R.stars)}</b>{R.stars === 1 ? "star" : "stars"}</li>
                          <li><Icon name="fork" size={13} /><b>{nf.format(R.forks)}</b>{R.forks === 1 ? "fork" : "forks"}</li>
                          {R.license && <li><Icon name="scale" size={13} /><b>{R.license}</b>licence</li>}
                        </ul>
                      </section>
                      {R.languages.length > 0 && (
                        <section class="p-built">
                          <h4 class="mono dim">Built with</h4>
                          <span class="jr-langs" aria-hidden="true">{R.languages.map((l, k) => <i style={`flex-grow: ${l.share}; opacity: ${[1, 0.55, 0.28][k]}`}></i>)}</span>
                          <ul class="jr-langlist">{R.languages.map((l, k) => <li><i style={`opacity: ${[1, 0.55, 0.28][k]}`} aria-hidden="true"></i>{l.name}<span class="mono dim">{l.share}%</span></li>)}</ul>
                        </section>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
        <div class="jr-axis mono dim">
          <span>{extra.length > 0 && (
            <span class="jr-ext jr-ext-axis">
              <button type="button" class="jr-ext-btn mono" aria-expanded="false" aria-controls="jr-ext-axis" aria-label={`More repositories (${extra.length})`}>More<svg class="jr-ext-chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
              <span class="jr-ext-menu" id="jr-ext-axis" role="group" aria-label="More repositories">
                {extra.map((x) => (
                  <button type="button" data-open={x} style={`--c: ${color(x)}`}>
                    <i aria-hidden="true"></i>
                    <b>{name(x)}</b>
                    <span class="jr-ext-n mono" aria-label={`${nf.format(A.repos[x].commits)} commits in the last 30 days`}><Icon name="commit" size={12} />{nf.format(A.repos[x].commits)}</span>
                    <span class="jr-ext-line">{lineOf(x)}</span>
                  </button>
                ))}
              </span>
            </span>
          )}</span>
          <div aria-hidden="true"><span class="jr-end">{short(A.days[0])}</span><b class="jr-mark"></b><span class="jr-end" data-last={A.days.at(-1)}>{short(A.days.at(-1)!)}</span></div>
          <span aria-hidden="true"><i class="jr-key"></i>Release</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* one colour per project (validated for colour-blind separation, light and dark) */
  .jr {
    --c0: #8a8f94;
    --c1: #0f9ac3;
    --c2: #eb6834;
    --c3: #6250d6;
    --c4: #eda100;
    --c5: #e87ba4;
    --c6: #008300;
    --who: 480px; /* the identity column; the strips take the rest */
    --tot: 52px;
    --out: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(:root[data-theme="dark"]) .jr {
    --c2: #d95926;
    --c3: #9085e9;
    --c4: #c98500;
    --c5: #d55181;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jr {
      --c2: #d95926;
      --c3: #9085e9;
      --c4: #c98500;
      --c5: #d55181;
    }
  }
  .jr button {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .jr :is(button, a):focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  /* the site's line, sitting on the panel's top edge */
  .jr-title {
    position: relative;
    isolation: isolate;
    margin: 0 0 20px;
    font-size: clamp(27px, 3.1vw, 46px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  /* no overlay: the page colour hugs the letters themselves (a map-label halo), so the mountain shows
     everywhere else, right up to the text and after it */
  .jr-title {
    text-shadow:
      0 0 3px var(--bg),
      0 0 7px var(--bg),
      0 0 14px var(--bg),
      0 0 26px var(--bg);
  }
  /* one panel: a solid ground over the river, so the section reads as a single object */
  .jr-panel {
    padding: 18px 32px 6px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--bg) 93%, transparent);
  }
  .jr-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .jr-nums {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 26px;
    margin: 0;
  }
  .jr-nums div {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }
  .jr-nums dd {
    font-size: 22px;
    line-height: 28px;
    font-weight: 500;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .jr-nums dt {
    font-size: 14px;
    color: var(--secondary);
  }
  .jr-nums .mono dt {
    font-size: 12px;
  }
  .jr-head p {
    display: flex;
    gap: 0 18px;
    font-size: 12px;
    white-space: nowrap;
  }
  .jr-cap,
  .jr-nav .jr-daymore,
  .jr-sheethead,
  .jr-sheettitle {
    display: none;
  }
  .jr-head p a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .jr-head p a:hover {
    color: var(--link);
  }

  /* ---- the day */
  /* the summary starts where the project descriptions start (dot 8 + gap 9 + name 76 + gap 9), so the day reads as one more row label */
  .jr-lead {
    display: grid;
    grid-template-columns: 93px minmax(0, 1fr);
    column-gap: 9px;
    margin-top: 16px;
  }
  .jr-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .jr-nav h3 {
    font-size: 17px;
    line-height: 27px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* wide screens: the day as a calendar leaf, read as text by screen readers through .jr-dl */
  @media (min-width: 900px) {
    .jr-nav {
      gap: 12px;
    }
    .jr-dl {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .jr-leaf {
      display: grid;
      justify-items: start;
    }
    .jr-lm,
    .jr-lw {
      font-size: 11px;
      line-height: 16px;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--secondary);
      white-space: nowrap;
    }
    .jr-ln {
      margin: 1px 0 2px -0.04em;
      font-size: 40px;
      line-height: 38px;
      font-weight: 500;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
    }
    /* a word, not a weekday: the relative day stands out */
    .jr-lw.is-rel {
      color: var(--text);
    }
  }
  @media (max-width: 899px) {
    .jr-leaf {
      display: none;
    }
  }
  .jr-nav div {
    display: flex;
    gap: 6px;
  }
  .jr-nav button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color 0.15s, transform 0.1s;
  }
  .jr-nav button:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--text) 45%, transparent);
  }
  .jr-nav button:active:not(:disabled) {
    transform: scale(0.94);
  }
  .jr-nav button:disabled {
    color: var(--secondary);
    opacity: 0.45;
    cursor: default;
  }
  /* every day in one cell: the cell is as tall as the longest, so choosing a day moves nothing */
  .jr-stack {
    display: grid;
  }
  .jr-stack article {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.14s linear, visibility 0s 0.14s;
  }
  .jr-stack article.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.14s linear;
  }
  .jr-text {
    max-width: 66ch;
    font-size: 19px;
    line-height: 27px;
    letter-spacing: -0.014em;
    text-wrap: pretty;
  }
  .jr-text a {
    text-decoration: underline;
    text-decoration-color: var(--c);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-thickness 0.12s;
  }
  .jr-text a:hover {
    text-decoration-thickness: 3px;
  }
  .jr-hl {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 25px;
  }
  .jr-hl b {
    font-weight: 500;
  }
  .jr-split {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 22px;
  }
  .jr-split li {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .jr-split i,
  .jr-who i {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }
  .jr-split .mono {
    font-size: 12px;
    white-space: nowrap;
  }
  .jr-split a:hover {
    color: var(--link);
  }
  .jr-rel {
    padding: 0 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    line-height: 20px;
  }

  /* ---- the projects: a row each, name on the left, its 30 days on the right */
  .jr-rows {
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .jr-item {
    scroll-margin-top: 84px;
    border-bottom: 1px solid var(--line);
  }
  .jr-rowline {
    display: grid;
    grid-template-columns: var(--who) minmax(0, 1fr) var(--tot) 32px;
    align-items: center;
    height: 50px;
    transition: height 0.36s var(--out), opacity 0.2s linear;
  }
  /* a project is open: the other rows fold away and a line of tabs takes their place, so it all fits one screen */
  .jr-tabs {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.36s var(--out);
  }
  .jr-tabs > div {
    min-height: 0;
    overflow: auto hidden; /* more repositories than fit: the line scrolls sideways */
    scrollbar-width: none;
    display: flex;
    align-items: center;
    gap: 6px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s linear;
  }
  .jr-tabs > div::-webkit-scrollbar {
    display: none;
  }
  .jr-tabs button {
    flex: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    margin: 8px 0 !important;
    padding: 0 10px !important;
    border: 1px solid var(--line) !important;
    border-radius: 999px;
    font-size: 13px !important;
    color: var(--secondary) !important;
    transition: border-color 0.15s, color 0.15s;
  }
  .jr-tabs button:hover {
    color: var(--text) !important;
    border-color: color-mix(in srgb, var(--text) 40%, transparent) !important;
  }
  .jr-tabs button[aria-pressed="true"] {
    border-color: var(--c) !important;
    color: var(--text) !important;
  }
  .jr-tabs i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
  }
  .jr-tabs .jr-all {
    position: sticky; /* the way back stays put when the line of tabs scrolls */
    left: 0;
    z-index: 1;
    margin-right: 10px !important;
    padding: 0 12px 0 9px !important;
    border-color: var(--text) !important;
    background: var(--text) !important;
    color: var(--bg) !important;
    font-weight: 500;
  }
  .jr-tabs .jr-all:hover {
    opacity: 0.86;
    color: var(--bg) !important;
  }
  @media (min-width: 900px) {
    .jr-rows.has-open .jr-tabs {
      grid-template-rows: 1fr;
    }
    .jr-rows.has-open .jr-tabs > div {
      visibility: visible;
      opacity: 1;
    }
    .jr-rows.has-open .jr-item:not(.is-open) {
      border-bottom-width: 0;
    }
    .jr-rows.has-open .jr-item:not(.is-open) .jr-rowline {
      height: 0;
      overflow: hidden;
      opacity: 0;
    }
    .jr-rows.has-open .jr-item.is-open {
      border-top: 1px solid var(--line);
      border-bottom-width: 0;
    }
  }
  .jr-rowline h3 {
    min-width: 0;
    height: 100%;
    font: inherit;
  }
  .jr-who {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    height: 100%;
    padding-right: 20px !important;
    font-size: 15px;
  }
  .jr-who i {
    background: var(--c);
  }
  .jr-who b {
    flex: none;
    width: 76px;
    font-weight: 500;
  }
  .jr-what {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }
  /* what kind of thing it is, how far along, and how it is received */
  /* fixed columns, so stage, stars, forks and platforms line up from row to row */
  .jr-meta {
    display: grid;
    grid-template-columns: 102px 78px auto;
    justify-content: start;
    overflow: hidden;
    white-space: nowrap;
    font-size: 11px;
    line-height: 16px;
    color: var(--secondary);
  }
  .jr-meta > * {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  /* stars and forks: one tight pair at the right end */
  .jr-gh {
    gap: 12px !important;
  }
  .jr-gh > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .jr-kinds {
    gap: 5px !important;
  }
  .jr-meta em {
    gap: 6px;
    font-style: normal;
    color: var(--text);
  }
  /* the stage as a ladder: Prototype, WIP, Alpha, Released */
  .jr-ladder {
    display: inline-flex;
    gap: 2px;
  }
  .jr-ladder i {
    width: 6px;
    height: 4px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--text) 16%, transparent);
  }
  .jr-ladder i.is-on {
    background: var(--c);
  }
  .jr-line {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 14px;
    color: var(--secondary);
    transition: color 0.15s;
  }
  .jr-tog {
    display: grid;
    place-items: center end;
    height: 100%;
    color: var(--secondary);
    transition: color 0.15s;
  }
  .jr-chev {
    transition: transform 0.3s var(--out);
  }
  .jr-who:hover .jr-line {
    color: var(--text);
  }
  .jr-tog:hover,
  .jr-rowline:has(.jr-who:hover) .jr-tog,
  .is-open .jr-tog {
    color: var(--text);
  }
  .is-open .jr-chev {
    transform: rotate(180deg);
  }
  /* ---- repositories past the featured ones. Not rows: the panel keeps its six rows and its one height. Each has a
     row's markup, so it opens in place, in a tab or as a sheet like any project, but takes no room until it is open */
  .jr-item.is-extra:not(.is-open) {
    border-bottom-width: 0;
  }
  .jr-item.is-extra:not(.is-open) .jr-rowline {
    height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
  }
  .jr-item.is-extra .jr-who b {
    width: auto;
    min-width: 76px; /* a repository's name is as long as it is; open, its row is the only one */
    white-space: nowrap;
  }
  /* no stage and no platforms to line up: its stars and forks start under its description */
  @media (min-width: 900px) {
    .jr-meta.is-bare {
      grid-template-columns: auto;
    }
    .jr-meta.is-bare > :empty {
      display: none;
    }
  }
  /* "More": a quiet menu at the left of the axis line, under the names. It lists them as small rows (name, commits,
     what it is); choosing one opens it */
  .jr-ext {
    position: relative;
    display: inline-flex;
  }
  .jr-ext-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    line-height: 16px;
    color: var(--secondary);
    transition: color 0.15s;
  }
  .jr-ext-btn:hover,
  .jr-ext.is-on .jr-ext-btn {
    color: var(--text);
  }
  .jr-ext-btn svg {
    margin-left: 4px;
    transition: transform 0.3s var(--out);
  }
  .jr-ext.is-on .jr-ext-btn svg {
    transform: rotate(180deg);
  }
  /* the axis: "More" under the names, the release legend under the totals */
  .jr-axis > span:last-child {
    grid-column: 3 / 5;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    white-space: nowrap;
  }
  .jr-axis > span:first-child {
    align-self: stretch;
  }
  .jr-ext-axis .jr-ext-btn {
    height: 100%;
  }
  .jr-ext-menu {
    position: absolute;
    z-index: 6;
    left: 0;
    bottom: calc(100% + 2px);
    display: grid;
    gap: 2px;
    width: max-content;
    min-width: 264px;
    max-width: min(400px, 100vw - 2 * var(--gutter));
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 16px 28px -16px rgb(0 0 0 / 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.12s linear, transform 0.2s var(--out), visibility 0s 0.2s;
  }
  .jr-ext.is-on .jr-ext-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.12s linear, transform 0.2s var(--out);
  }
  .jr-ext-menu button {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr) auto;
    align-items: center;
    gap: 1px 9px;
    padding: 7px 10px 8px;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 20px;
    color: var(--text);
    transition: background-color 0.12s;
  }
  .jr-ext-menu button:hover,
  .jr-ext-menu button:focus-visible {
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }
  .jr .jr-ext-menu button:focus-visible {
    outline-offset: -2px;
  }
  .jr-ext-menu i {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--c);
  }
  .jr-ext-menu b {
    font-weight: 500;
    white-space: nowrap;
  }
  .jr-ext-n {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--secondary);
  }
  .jr-ext-n svg {
    opacity: 0.6;
  }
  .jr-ext-line {
    grid-column: 2 / -1;
    white-space: normal;
    text-wrap: pretty;
    font-size: 13px;
    line-height: 18px;
    color: var(--secondary);
  }
  /* the strip: thirty slots on the axis every row shares */
  .jr-strip {
    --plot: 32px;
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .jr-strip > span {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--plot);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  /* every bar the same width whatever the window, standing on the row's line */
  .jr-strip span > i {
    display: block;
    width: min(100% - 3px, 14px);
    height: max(3px, calc(var(--v) * var(--plot)));
    border-radius: 2.5px 2.5px 0 0;
    background: var(--c);
    transform-origin: 50% 100%;
  }
  .jr-strip span.is-over > i {
    -webkit-mask-image: linear-gradient(#000 5px, transparent 5px, transparent 7px, #000 7px);
    mask-image: linear-gradient(#000 5px, transparent 5px, transparent 7px, #000 7px);
  }
  /* a release: a small dot above that day's bar */
  .jr-strip u,
  .jr-key {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text);
  }
  .jr-strip u {
    position: absolute;
    left: 50%;
    bottom: calc(max(3px, var(--v) * var(--plot)) + 3px);
    margin-left: -2px;
  }
  /* the chosen day and the day pointed at: one column through every row */
  .jr-strip::before,
  .jr-strip::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--sel) / var(--days) * 100%);
    width: calc(100% / var(--days));
    background: color-mix(in srgb, var(--text) 7%, transparent);
    pointer-events: none;
  }
  .jr-strip::after {
    left: calc(var(--view, 0) / var(--days) * 100%);
    background: color-mix(in srgb, var(--text) 5%, transparent);
    opacity: 0;
  }
  .jr.has-view .jr-strip::after {
    opacity: 1;
  }
  /* while a day is pointed at, the totals give way to that day's commits */
  .jr-total.is-day {
    color: var(--text);
  }
  .jr-total {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .jr-total svg {
    flex-shrink: 0;
    opacity: 0.6;
  }
  .jr-total.is-day svg {
    opacity: 1;
  }
  /* the bars rise once, day after day, when the panel first shows */
  @media (prefers-reduced-motion: no-preference) {
    .jr:not(.is-in) .jr-strip span > i {
      transform: scaleY(0);
    }
    .jr.is-in .jr-strip span > i {
      animation: jr-rise 0.5s var(--out) backwards;
      animation-delay: calc(var(--i) * 12ms + var(--row) * 45ms);
    }
  }
  @keyframes jr-rise {
    from {
      transform: scaleY(0);
    }
  }
  .jr-axis {
    display: grid;
    grid-template-columns: var(--who) minmax(0, 1fr) var(--tot) 32px;
    align-items: center;
    height: 26px;
    font-size: 11px;
  }
  /* one size for the panel whatever it shows: every opened project takes the room the longest one needs, and
     the six rows of the default view share that same height */
  @media (min-width: 900px) {
    .jr-view {
      min-height: 254px;
    }
    .jr-rows:not(.has-open) .jr-rowline {
      height: 57px;
    }
    .jr-rows:not(.has-open) .jr-strip {
      --plot: 38px;
    }
  }
  /* the axis belongs under the chart: with a project open, its own copy shows right below its strip */
  .jr-axis-in {
    display: none;
  }
  @media (min-width: 900px) {
    .jr-rows.has-open > .jr-axis {
      display: none;
    }
    .jr-item.is-open .jr-axis-in {
      display: grid;
      height: 22px;
      margin-bottom: 5px;
    }
    /* nothing above the tabs but space */
    .jr-rows.has-open {
      border-top-color: transparent;
    }
  }
  .jr-axis > span:first-child {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .jr-axis > span:last-child {
    text-align: right;
  }
  .jr-axis div {
    position: relative;
    display: flex;
    justify-content: space-between;
  }
  .jr-end {
    transition: opacity 0.15s;
  }
  .jr-end.is-off {
    opacity: 0;
  }
  /* the chosen day's date rides under its column */
  .jr-mark {
    position: absolute;
    top: 0;
    left: calc((var(--sel) + 0.5) / var(--days) * 100%);
    transform: translateX(-50%);
    font-weight: 400;
    color: var(--text);
    white-space: nowrap;
  }
  .jr-mark.at-start {
    left: 0;
    transform: none;
  }
  .jr-mark.at-end {
    left: auto;
    right: 0;
    transform: none;
  }

  /* ---- a project, opened in place */
  .jr-more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s var(--out);
  }
  .is-open .jr-more {
    grid-template-rows: 1fr;
  }
  .jr-more-in {
    min-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s 0.42s;
  }
  .is-open .jr-more-in {
    visibility: visible;
    transition: none;
  }
  .jr-view {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 372px;
    column-gap: 28px;
    padding: 0 0 10px;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s linear, transform 0.42s var(--out);
  }
  .is-open .jr-view {
    opacity: 1;
    transform: none;
    transition: opacity 0.3s linear 0.08s, transform 0.42s var(--out);
  }
  /* opening, closing or switching on wide screens: the panel is the same size in every state (six rows plus the
     axis = tabs plus one open project), so nothing folds or unfolds. The layout changes at once; the row that
     stays on screen glides from where it was to where it lands (script), and the rest fades in around it */
  @media (min-width: 900px) {
    .jr-rows.is-snap .jr-tabs,
    .jr-rows.is-snap .jr-more,
    .jr-rows.is-snap .jr-more-in,
    .jr-rows.is-snap .jr-item:not(.is-open) .jr-view {
      transition: none;
    }
    .jr-rows.is-snap .jr-rowline {
      transition: opacity 0.24s linear 0.12s;
    }
    .jr-rows.is-snap .is-open .jr-view {
      transform: none;
      transition: opacity 0.26s linear 0.1s;
    }
    /* the gliding row starts where it was, at its new height: keep it inside the panel so the page never grows */
    .jr-rows.is-gliding {
      overflow: clip;
    }
  }
  /* with a film: the film on the left, everything about the project on the right */
  .jr-view.has-film {
    grid-template-columns: auto minmax(0, 1fr) 372px;
  }
  .jr-film {
    position: relative;
    align-self: start;
    height: 196px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
  }
  .jr-film video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jr-sound {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 13px 0 11px !important;
    border: 1px solid var(--line) !important;
    border-radius: 999px;
    background: var(--bg) !important;
    font-size: 12px !important;
    transition: border-color 0.15s;
  }
  .jr-sound:hover {
    border-color: color-mix(in srgb, var(--text) 45%, transparent) !important;
  }
  .jr-sub {
    font-size: 17px;
    line-height: 24px;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  /* three things it does, one line each */
  .jr-points {
    display: grid;
    gap: 4px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 21px;
    color: color-mix(in srgb, var(--text) 80%, transparent);
  }
  .jr-points li {
    position: relative;
    padding-left: 16px;
  }
  .jr-points li::before {
    content: "";
    position: absolute;
    left: 1px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: var(--c);
  }
  .jr-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jr-needs {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
  }
  .jr-stagehead .jr-chips {
    flex-wrap: nowrap;
  }
  .jr-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 8px 14px;
  }
  /* with a film: the film and the way to the project on the left, what it is in the middle, its figures on the right */
  @media (min-width: 900px) {
    .jr-view.has-film {
      grid-template-rows: auto 1fr;
      row-gap: 14px;
    }
    .jr-view.has-film .jr-film {
      grid-area: 1 / 1;
    }
    /* as wide as the film, never wider: it must not widen the column */
    .jr-view.has-film .jr-acts {
      grid-area: 2 / 1;
      width: 0;
      min-width: 100%;
    }
    .jr-view.has-film .jr-about {
      grid-area: 1 / 2 / -1 / 2;
    }
    .jr-view.has-film .jr-profile {
      grid-area: 1 / 3 / -1 / 3;
    }
    .jr-view:not(.has-film) {
      grid-template-rows: auto 1fr;
      row-gap: 16px;
    }
    .jr-view:not(.has-film) .jr-profile {
      grid-area: 1 / 2 / -1 / 2;
    }
    /* the figures take the full height: their sections spread over it */
    .jr-profile {
      align-content: space-between !important;
    }
  }
  .jr-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    transition: border-color 0.15s, opacity 0.15s;
  }
  .jr-links a:first-child {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }
  .jr-links a:first-child:hover {
    opacity: 0.86;
  }
  .jr-links a:not(:first-child):hover {
    border-color: color-mix(in srgb, var(--text) 45%, transparent);
  }
  .jr-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
  }
  .jr-chips li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    line-height: 18px;
    color: var(--secondary);
  }
  .jr-chips a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .jr-chips a:hover {
    color: var(--link);
  }
  /* ---- the project in figures: where it stands, its whole life, its last month, what it is made of */
  .jr-profile {
    display: grid;
    grid-template: "stage stage stage" auto "days life github" auto "built built built" auto / minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    align-content: start;
    gap: 12px 24px;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  /* no stage to show: its figures start at the top, level with the text beside them */
  .jr-profile.is-bare {
    grid-template-areas: "days life github" "built built built";
    grid-template-rows: auto auto;
  }
  /* what kind of thing it is and where it runs, on the stage's line */
  .jr-stagehead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 22px;
    margin-bottom: 5px;
  }
  .jr-stagehead h4 {
    margin: 0 !important;
  }
  .jr-profile section {
    margin: 0;
    padding: 0;
    min-height: 0;
  }
  .p-stage {
    grid-area: stage;
  }
  .p-days {
    grid-area: days;
  }
  .p-built {
    grid-area: built;
  }
  .p-life {
    grid-area: life;
  }
  .p-github {
    grid-area: github;
  }
  .jr-profile h4 {
    white-space: nowrap;
    margin-top: 0;
    margin-bottom: 5px;
    font-size: 11px;
    line-height: 16px;
    font-weight: 400;
  }
  .jr-stage {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    line-height: 16px;
    color: var(--secondary);
  }
  .jr-stage li::before {
    content: "";
    display: block;
    height: 4px;
    margin-bottom: 6px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text) 14%, transparent);
  }
  .jr-stage li.is-done::before {
    background: var(--c);
  }
  .jr-stage li:not(.is-now) {
    opacity: 0.45;
  }
  .jr-stage li.is-now {
    font-weight: 500;
    color: var(--text);
  }
  /* figures, one per line: icon, number, what it counts */
  .jr-figs {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 20px;
    color: var(--secondary);
  }
  .jr-figs li {
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .jr-figs a {
    display: inline-flex;
    gap: 7px;
    padding-left: 20px;
  }
  .jr-figs a:hover {
    color: var(--link);
  }
  .jr-figs b {
    font-weight: 500;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .jr-langs {
    display: flex;
    gap: 2px;
    height: 5px;
    border-radius: 3px;
    overflow: hidden;
  }
  .jr-langs i,
  .jr-langlist i {
    background: var(--c);
  }
  .jr-langlist {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin: 7px 0 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    line-height: 18px;
  }
  .jr-langlist li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .jr-langlist i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .jr-langlist .mono {
    font-size: 11px;
  }
  .jr-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 6px;
    font-size: 11px;
  }
  .jr-foot a:hover {
    color: var(--link);
  }
  @media (prefers-reduced-motion: reduce) {
    .jr *,
    .jr *::before,
    .jr *::after {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  /* ---- 900 to 1279px wide: a film, the text and the figures side by side would crush the text between them
     (46px of it at 960). A project with a film opens in two bands instead: what it is on top (the film and the
     ways to it, its line, its three points), its figures in one line under it. One without a film keeps its two
     columns. The panel still has one height in every state: the view is as tall as the fullest project needs,
     and the six rows of the default view share that height. */
  @media (min-width: 900px) and (max-width: 1279px) {
    .jr-view {
      min-height: 344px; /* 254 + 6 × 15: lastdrop's text beside its film at 900px */
    }
    .jr-rows:not(.has-open) .jr-rowline {
      height: 72px;
    }
    .jr-rows:not(.has-open) .jr-strip {
      --plot: 46px;
    }
    .jr-view.has-film {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 12px 28px;
    }
    .jr-view.has-film .jr-film {
      grid-area: 1 / 1;
      height: 150px;
    }
    .jr-view.has-film .jr-acts {
      grid-area: 2 / 1;
    }
    /* under a smaller film: the site by name, GitHub by its mark */
    .jr-view.has-film .jr-links {
      flex-wrap: nowrap;
    }
    .jr-view.has-film .jr-links a:not(:first-child) {
      justify-content: center;
      flex: none;
      width: 34px;
      padding: 0;
      gap: 0;
      font-size: 0;
    }
    .jr-view.has-film .jr-about {
      grid-area: 1 / 2 / 3 / -1;
    }
    .jr-view.has-film .jr-sub {
      max-width: 34em;
    }
    .jr-view.has-film .jr-points {
      max-width: 44em;
      align-content: start;
    }
    .jr-view.has-film .jr-needs {
      margin-top: 10px;
    }
    /* the figures: one line across */
    .jr-view.has-film .jr-profile {
      grid-area: 3 / 1 / 4 / -1;
      grid-template: "stage days life github built" auto / minmax(248px, 3fr) auto auto auto minmax(120px, 2fr);
      align-content: start !important;
      gap: 0 clamp(18px, 2.4vw, 32px);
      padding: 8px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    /* what kind of thing it is and where it runs is in the row above, as icons */
    .jr-view.has-film .jr-stagehead .jr-chips {
      display: none;
    }
    .jr-view.has-film .jr-stagehead {
      min-height: 16px;
    }
    .jr-view.has-film .jr-stage {
      margin-top: 9px;
    }
    .jr-view.has-film .jr-langs {
      margin-top: 4px;
    }
    /* one language per line, as tall as the figures beside it */
    .jr-view.has-film .jr-langlist {
      display: grid;
      margin-top: 5px;
      line-height: 16px;
    }
    .jr-view.has-film .jr-langlist .mono {
      line-height: inherit;
    }
  }
  /* from 1100px the text has room for two columns of its own beside the film: its line, then its points */
  @media (min-width: 1100px) and (max-width: 1279px) {
    .jr-view {
      min-height: 320px; /* 254 + 6 × 11 */
    }
    .jr-rows:not(.has-open) .jr-rowline {
      height: 68px;
    }
    .jr-rows:not(.has-open) .jr-strip {
      --plot: 44px;
    }
    .jr-view.has-film {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    }
    .jr-view.has-film .jr-about {
      display: contents;
    }
    .jr-view.has-film .jr-sub {
      grid-area: 1 / 2;
    }
    .jr-view.has-film .jr-needs {
      grid-area: 2 / 2;
      align-self: start;
      height: 34px;
      margin: 0;
    }
    .jr-view.has-film .jr-points {
      grid-area: 1 / 3 / 3 / 4;
      margin: 3px 0 0;
    }
  }
  /* just past 1280px the text column is at its narrowest (359px): lastdrop's, the fullest, was 1px too tall for the
     view, which made the panel 1px taller on that tab alone */
  @media (min-width: 1280px) and (max-width: 1299px) {
    .jr-needs {
      margin-top: 10px;
    }
  }
  /* 900 to 1239px: the month's figures with their labels under them and the caption in two short lines, as under
     900px (in one line they wrapped) */
  @media (min-width: 900px) and (max-width: 1239px) {
    .jr-head {
      align-items: flex-end;
    }
    .jr-nums {
      flex-wrap: nowrap;
      gap: 0 30px;
    }
    .jr-nums div {
      flex-direction: column;
      gap: 0;
    }
    .jr-nums dd {
      line-height: 26px;
    }
    .jr-nums dt {
      font-size: 12px;
      line-height: 16px;
    }
    .jr-nums .mono,
    .jr-contrib {
      display: none;
    }
    .jr-head p {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      justify-items: end;
      gap: 0 14px;
      font-size: 11px;
      line-height: 16px;
    }
    .jr-cap {
      display: inline;
      grid-column: 1 / -1;
    }
  }

  /* 900 to 1099px: a narrower identity column, so the strips keep their room, and rows tall enough for what the
     project is to take two lines instead of being cut (6px more on the open row, 1px on each of the six) */
  @media (min-width: 900px) and (max-width: 1099px) {
    .jr {
      --who: 380px;
    }
    .jr-item.is-open .jr-rowline {
      height: 56px;
    }
    .jr-rows:not(.has-open) .jr-rowline {
      height: 73px;
    }
    /* stars and forks do not fit beside the stage here: they are in the open project */
    .jr-meta .jr-gh {
      display: none;
    }
    .jr-line {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      white-space: normal;
      line-height: 18px;
      text-wrap: balance;
    }
    .jr-rows:not(.has-open) .jr-what {
      gap: 4px;
    }
    .jr-item.is-open .jr-what {
      gap: 1px;
    }
  }
  /* ---- under 900px wide (phones, tablets, a laptop's half screen): one column. What every such screen shares;
     the compact one-screen design itself follows below. */
  @media (max-width: 899px) {
    /* the month in figures, each with its label under it, then where it comes from */
    .jr-head {
      display: block;
    }
    .jr-nums {
      display: grid;
    }
    .jr-nums div {
      flex-direction: column;
      gap: 0;
    }
    .jr-nums .mono {
      display: none;
    }
    .jr-head p {
      gap: 0 14px;
    }
    .jr-cap {
      display: inline !important;
    }
    .jr-contrib {
      display: none;
    }
    /* the day: its name and the arrows on one line, then the summary */
    .jr-lead {
      grid-template-columns: minmax(0, 1fr);
    }
    .jr-nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .jr-split {
      gap: 2px 20px;
    }
    .jr-split li {
      flex-wrap: wrap;
      gap: 0 7px;
    }
    /* the projects. The axis heads the charts: first, with its dates over the strips they label */
    .jr-rows {
      display: flex;
      flex-direction: column;
    }
    .jr-rows > .jr-axis {
      order: -1;
      border-bottom: 1px solid var(--line);
    }
    .jr-item {
      scroll-margin-top: 16px;
    }
    .jr-rowline {
      height: auto;
    }
    .jr-who {
      padding: 0 !important;
    }
    .jr-total {
      grid-row: 1;
      pointer-events: none;
    }
    .jr-tog {
      grid-row: 1;
    }
    .jr-strip {
      --plot: 34px;
    }
    /* pressed: the whole row answers */
    .jr-item:not(.is-open) .jr-rowline {
      transition: background-color 0.15s;
    }
    .jr-item:not(.is-open) .jr-rowline:active {
      background: color-mix(in srgb, var(--text) 4%, transparent);
    }
    .jr-film {
      border-radius: 12px;
    }
    .jr-profile {
      padding: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .jr-profile h4 {
      white-space: normal;
    }
    .jr-figs li {
      gap: 5px;
    }
    .jr-figs a {
      padding-left: 0;
      gap: 5px;
      flex-wrap: wrap;
    }
    .jr-stagehead {
      flex-wrap: wrap;
    }
  }
  /* phones: the panel becomes a sheet across the whole width, rising over the mountain */
  @media (max-width: 599px) {
    .jr .wrap {
      padding-inline: 0;
    }
    .jr-title {
      padding-inline: var(--gutter);
    }
    .jr-nums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* the projects that moved that day: one per line, releases flush right */
    .jr-split {
      display: grid;
      gap: 0;
      margin-top: 14px;
    }
    .jr-split li {
      flex-wrap: wrap;
      gap: 0 8px;
      min-height: 40px;
      padding: 6px 0;
      border-top: 1px solid var(--line);
    }
    .jr-split li > a:first-of-type {
      font-weight: 500;
    }
    .jr-split .jr-rel {
      margin-left: auto;
    }
    /* a link in the list takes the full line height to the touch */
    .jr-split a {
      position: relative;
    }
    .jr-split a::after {
      content: "";
      position: absolute;
      inset: -10px -4px;
    }
    /* the film never takes more than a quarter of the screen: full width, a squarer one letterboxed in it */
    .jr-film {
      height: min(25svh, 222px) !important;
      aspect-ratio: auto !important;
    }

    .jr-panel {
      padding: 22px var(--gutter) 4px;
      border-width: 1px 0 0;
      border-radius: 22px 22px 0 0;
      background: var(--bg);
    }
  }
  /* ==== under 900px wide: one screen, nothing scrolls (given 520px of height; shorter, the same design scrolls).
     The mountain and the line on top; then the month in four figures, the day (its summary in a fixed slot, the
     whole day unrolls over the list), and the six projects as compact rows on the shared axis. A project opens as
     a sheet over everything (swipe down, back or ✕ to close). Written for phones; 600px and up adjusts it below. */
  @media (max-width: 899px) {
    .jr {
      --rowh: 36px;
      --plot: 20px;
      --lines: 3;
      --lh: 20px;
      --name: 84px;
      --fig: 34px;
    }
    .jr-title {
      margin-bottom: 10px;
      font-size: 21px;
      line-height: 23px;
    }
    .jr-nav button {
      width: 36px;
      height: 36px;
    }
    .jr-panel {
      padding: 14px var(--gutter) calc(6px + env(safe-area-inset-bottom));
    }
    /* the month: four figures in a row, where they come from under them */
    .jr-nums {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 10px;
    }
    .jr-nums dd {
      font-size: 18px;
      line-height: 22px;
    }
    .jr-nums dt {
      font-size: 11px;
      line-height: 14px;
      white-space: nowrap;
    }
    .jr-head p {
      justify-content: space-between;
      margin-top: 6px;
      padding-top: 0;
      border-top: 0;
      font-size: 11px;
      line-height: 16px;
    }
    .jr-head p a,
    .jr-upd {
      display: none;
    }
    .jr-head p {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
    /* the day */
    .jr-lead {
      position: relative;
      row-gap: 2px;
      margin-top: 8px;
      padding-top: 6px;
      border-top: 1px solid var(--line);
    }
    .jr-nav h3 {
      font-size: 16px;
    }
    .jr-nav .jr-daymore {
      display: grid !important;
      place-items: center;
      width: 32px;
      height: 40px;
      margin-right: auto;
      border: 0;
      border-radius: 8px;
      color: var(--secondary);
    }
    .jr-daymore svg {
      transition: transform 0.24s var(--out);
    }
    .jr-lead.is-full .jr-daymore {
      color: var(--text);
    }
    .jr-lead.is-full .jr-daymore svg {
      transform: rotate(180deg);
    }
    .jr-nav div {
      gap: 4px;
    }
    /* a fixed slot: changing day moves nothing. The day is laid over it and clipped to it; unrolled, it covers the list */
    .jr-stack {
      position: relative;
      height: calc(var(--lines) * var(--lh));
      touch-action: pan-y;
    }
    .jr-stack article,
    .jr-stack article:not(.is-on) {
      display: block;
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      padding-bottom: 14px;
      background: var(--bg);
      clip-path: inset(0 0 calc(100% - var(--lines) * var(--lh)) 0);
      transition: opacity 0.14s linear, visibility 0s 0.14s, clip-path 0.24s var(--out);
    }
    .jr-stack article.is-on {
      transition: opacity 0.14s linear, clip-path 0.24s var(--out);
    }
