<script>
  const root = document.querySelector<HTMLElement>('[data-jr]')!;
  // The data is as old as the last sync; say so in the reader's own time, and name the days from their side of midnight.
  const t = root.querySelector('time')!;
  const mins = Math.max(0, Math.round((Date.now() - new Date(root.dataset.synced!).getTime()) / 60000));
  t.textContent = mins < 1 ? 'just now' : mins < 60 ? `${mins} min ago` : mins < 1440 ? `${Math.round(mins / 60)} h ago` : `${Math.round(mins / 1440)} d ago`;
  const paris = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
  const today = paris.format(new Date()), yesterday = paris.format(new Date(Date.now() - 864e5));
  const arts = [...root.querySelectorAll<HTMLElement>('.jr-stack article')].reverse(); // oldest first
  for (const a of arts) {
    if (a.dataset.day === today) a.dataset.label = 'Today, so far';
    else if (a.dataset.day === yesterday) a.dataset.label = 'Yesterday';
  }
  const days = Number(getComputedStyle(root).getPropertyValue('--days'));
  const ends = [...root.querySelectorAll<HTMLElement>('.jr-end')];
  for (const e of ends) if (e.dataset.last === today) e.textContent = 'Today';
  new IntersectionObserver((es, io) => es[0].isIntersecting && (root.classList.add('is-in'), io.disconnect()), { threshold: 0.15 }).observe(root);

  // ---- days: across the strips. Pointing previews a day, choosing one keeps it.
  const title = root.querySelector('.jr-nav h3')!;
  const marks = [...root.querySelectorAll<HTMLElement>('.jr-mark')];
  const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.jr-nav [data-step]');
  const byIndex = new Map(arts.map((a) => [Number(a.dataset.i), a]));
  let kept = arts.findIndex((a) => a.classList.contains('is-on'));
  const totals = [...root.querySelectorAll<HTMLElement>('.jr-rowline')].map((r) => {
    const el = r.querySelector<HTMLElement>('.jr-total')!;
    const num = el.querySelector<HTMLElement>('.jr-num') || el;
    const daily = r.querySelector<HTMLElement>('.jr-strip')!.dataset.daily!.split(',');
    return [el, num, daily] as const;
  });
  const rows = root.querySelector<HTMLElement>('.jr-rows')!;
  const narrow = matchMedia('(max-width: 899px)');
  // phones held upright: one screen, the project as a sheet (see the styles)
  const phone = matchMedia('(max-width: 599px) and (min-height: 520px)');
  const lead = root.querySelector<HTMLElement>('.jr-lead')!;
  const show = (n: number, keep: boolean, pointing = false, still = false) => {
    const art = arts[n];
    if (!art) return;
    // narrow screens size the summary to its day: when the change comes from the strips, they must not move
    const at = still && narrow.matches ? rows.getBoundingClientRect().top : null;
    if (keep) kept = n;
    for (const a of arts) {
      a.classList.toggle('is-on', a === art);
      a.inert = a !== art;
    }
    title.textContent = art.dataset.label!;
    const i = Number(arts[kept].dataset.i);
    root.style.setProperty('--sel', String(i));
    const viewing = art !== arts[kept];
    root.classList.toggle('has-view', viewing);
    if (viewing) root.style.setProperty('--view', art.dataset.i!);
    // the date under the chosen column; near an end it takes that end's place
    for (const mark of marks) {
      mark.textContent = arts[kept].dataset.label!.replace(/, so far$/, '').replace(/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) /, '');
      mark.classList.toggle('at-start', i < 3);
      mark.classList.toggle('at-end', i > days - 4);
    }
    for (const e of ends) e.classList.toggle('is-off', e.dataset.last ? i > days - 7 : i < 6);
    // pointing at a day: each row's total gives way to that day's commits
    // on phones the rows always say the shown day's commits, and a project that did nothing that day steps back
    const di = viewing || pointing || phone.matches ? Number(art.dataset.i) : -1; // also when the day pointed at is the chosen one
    for (const [el, num, daily] of totals) {
      el.closest('.jr-item')!.classList.toggle('is-quiet', phone.matches && daily[di] === '0');
      const val = di < 0 ? el.dataset.total! : daily[di];
      num.textContent = val;
      el.classList.toggle('is-day', di >= 0);
      el.title = di < 0 ? `${el.dataset.total} commits in the last 30 days` : `${val} ${val === '1' ? 'commit' : 'commits'}`;
    }
    prev.disabled = kept <= 0;
    next.disabled = kept >= arts.length - 1;
    if (at !== null) scrollBy(0, rows.getBoundingClientRect().top - at);
    // the summary cut by its slot: say so (a fade on the last line)
    const text = art.querySelector<HTMLElement>('.jr-text, .jr-hl');
    lead.classList.toggle('is-long', !!text && text.offsetHeight > (art.parentElement as HTMLElement).clientHeight + 1);
  };
  // the day under the pointer: the strips share one axis, so only x matters
  const dayAt = (e: PointerEvent | MouseEvent) => {
    const strip = (e.target as Element).closest('.jr-strip');
    if (!strip) return -1;
    const r = strip.getBoundingClientRect();
    const a = byIndex.get(Math.max(0, Math.min(days - 1, Math.floor(((e.clientX - r.left) / r.width) * days))));
    return a ? arts.indexOf(a) : -1;
  };
  // a finger: dragging along a strip scrubs through the days, a plain tap on it opens its project (the row is one target)
  let scrubbed = false;
  rows.addEventListener('pointerdown', () => (scrubbed = false));
  rows.addEventListener('pointermove', (e) => {
    const n = dayAt(e);
    if (e.pointerType === 'mouse') show(n < 0 ? kept : n, false, n >= 0);
    else if (n >= 0 && n !== kept) (show(n, true, false, true), (scrubbed = true));
  });
  rows.addEventListener('pointerleave', () => show(kept, false));
  rows.addEventListener('click', (e) => {
    const n = dayAt(e);
    if (n < 0) return;
    const pe = e as PointerEvent;
    if (pe.pointerType === 'touch' || pe.pointerType === 'pen') {
      if (scrubbed) return;
      const id = (e.target as Element).closest<HTMLElement>('.jr-item')!.dataset.r!;
      return set(id === open ? null : id, true);
    }
    show(n, true, pe.pointerType === 'mouse', true);
  });
  prev.addEventListener('click', () => show(kept - 1, true));
  next.addEventListener('click', () => show(kept + 1, true));
  root.querySelector('.jr-nav')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k !== 'ArrowLeft' && k !== 'ArrowRight') return;
    e.preventDefault();
    show(kept + (k === 'ArrowLeft' ? -1 : 1), true);
  });
  show(kept, true);

  // ---- phones: the whole day unrolls over the list (the chevron, or a tap on the summary); a swipe changes day
  const more = root.querySelector<HTMLButtonElement>('.jr-daymore')!;
  const full = (on: boolean) => {
    lead.classList.toggle('is-full', on);
    more.setAttribute('aria-expanded', String(on));
  };
  more.addEventListener('click', () => full(!lead.classList.contains('is-full')));
  const stack = root.querySelector<HTMLElement>('.jr-stack')!;
  let sx = 0, sy = 0;
  stack.addEventListener('pointerdown', (e) => {
    sx = e.clientX;
    sy = e.clientY;
    delete stack.dataset.swiped;
  });
  stack.addEventListener('pointerup', (e) => {
    if (!phone.matches || e.pointerType === 'mouse') return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      const step = dx > 0 ? -1 : 1; // the finger pulls the earlier day in from the left
      if (arts[kept + step]) {
        show(kept + step, true);
        const on = arts[kept];
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) on.animate([{ transform: `translateX(${-step * 14}px)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 200, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
      }
      stack.dataset.swiped = '1';
    }
  });
  stack.addEventListener('click', (e) => {
    if (stack.dataset.swiped) return void delete stack.dataset.swiped;
    if (!phone.matches || (e.target as Element).closest('a')) return;
    full(!lead.classList.contains('is-full'));
  });
  // a tap anywhere else folds it back (and does nothing more)
  document.addEventListener('click', (e) => {
    if (!lead.classList.contains('is-full') || lead.contains(e.target as Node)) return;
    e.preventDefault();
    e.stopPropagation();
    full(false);
  }, true);

  // ---- projects: a row's name, or a project named in a summary, opens it in place. One at a time.
  const its = [...root.querySelectorAll<HTMLElement>('.jr-item')];
  let open: string | null = null;
  // the river takes the colour of the project pointed at, else of the one that is open, else its own
  const tint = (id: string | null) => {
    const it = its.find((x) => x.dataset.r === id);
    const hex = it && getComputedStyle(it).getPropertyValue('--c').trim().match(/^#([0-9a-f]{6})$/i)?.[1];
    const color = hex ? [0, 2, 4].map((k) => Number.parseInt(hex.slice(k, k + 2), 16) / 255) : null;
    (window as unknown as { __tint: number[] | null }).__tint = color; // the scene mounts late: it reads this when it does
    document.dispatchEvent(new CustomEvent('px:tint', { detail: { color } }));
  };
  // ---- phones: the project as a sheet over the screen
  let pushed = false;
  const page = () => [document.querySelector('.top'), document.querySelector('.top-logo'), document.querySelector('.hero'), document.querySelector('.foot'), root.querySelector('.jr-title'), root.querySelector('.jr-head'), lead, root.querySelector('.jr-tabs'), rows.querySelector(':scope > .jr-axis')].filter(Boolean) as HTMLElement[];
  const sheet = (id: string | null, prev: string | null, opts: { history?: boolean; instant?: boolean }) => {
    // from one project to another, or a deep link: no slide, the sheet is simply there
    if ((prev && id) || opts.instant) {
      rows.classList.add('is-swap');
      void rows.offsetHeight;
      requestAnimationFrame(() => requestAnimationFrame(() => rows.classList.remove('is-swap')));
    }
    for (const el of page()) el.inert = !!id;
    for (const it of its) {
      const on = it.dataset.r === id;
      it.inert = !!id && !on;
      for (const el of it.querySelectorAll<HTMLElement>('.jr-rowline, .jr-axis-in')) el.inert = on;
      const m = it.querySelector<HTMLElement>('.jr-more')!;
      if (on) {
        m.setAttribute('role', 'dialog');
        m.setAttribute('aria-modal', 'true');
        m.setAttribute('aria-labelledby', `jr-name-${id}`);
        m.querySelector('.jr-view')!.scrollTop = 0;
        m.querySelector('[aria-current="true"]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
        m.style.transform = '';
      }
    }
    document.dispatchEvent(new CustomEvent('px:viewer', { detail: { open: !!id } }));
    if (id) its.find((x) => x.dataset.r === id)!.querySelector<HTMLElement>('.jr-x')!.focus({ preventScroll: true });
    else if (prev) its.find((x) => x.dataset.r === prev)!.querySelector<HTMLElement>('.jr-who')!.focus({ preventScroll: true });
    if (opts.history) return;
    if (id && !prev) {
      history.pushState(null, '', `#${id}`);
      pushed = true;
    } else if (!id && pushed) {
      pushed = false;
      history.back(); // the hash empties; fromHash finds nothing open and stops there
    } else history.replaceState(null, '', id ? `#${id}` : location.pathname + location.search);
  };
  // drag the sheet's head down to put it away
  for (const it of its) {
    const m = it.querySelector<HTMLElement>('.jr-more')!;
    const head = it.querySelector<HTMLElement>('.jr-sheethead')!;
    let y0 = -1, t0 = 0, dy = 0;
    head.addEventListener('pointerdown', (e) => {
      if (!phone.matches || e.pointerType === 'mouse' || (e.target as Element).closest('.jr-x')) return;
      y0 = e.clientY;
      t0 = e.timeStamp;
      dy = 0;
    });
    head.addEventListener('pointermove', (e) => {
      if (y0 < 0) return;
      dy = Math.max(0, e.clientY - y0);
      if (dy > 6) {
        m.style.transition = 'none';
        m.style.transform = `translateY(${dy}px)`;
      }
    });
    const end = (e: PointerEvent) => {
      if (y0 < 0) return;
      y0 = -1;
      m.style.transition = '';
      if (dy > 96 || (dy > 24 && dy / (e.timeStamp - t0) > 0.5)) {
        set(null); // the class transition carries on from where the finger left it
        m.style.transform = '';
      } else if (dy > 6) {
        m.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 220, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
        m.style.transform = '';
      }
    };
    head.addEventListener('pointerup', end);
    head.addEventListener('pointercancel', end);
  }
  // one screen, unless the panel cannot fit it: then the page scrolls rather than hides anything
  const main = document.querySelector<HTMLElement>('main.is-landing');
  const fit = () => {
    if (!main) return;
    main.classList.remove('is-loose');
    if (!phone.matches) return;
    // the unrolled day hangs below its slot (clipped), so ask where the last block ends, not how far main scrolls
    const end = Math.max(...[...main.children].map((c) => (c as HTMLElement).offsetTop + (c as HTMLElement).offsetHeight));
    if (end > main.clientHeight + 1) main.classList.add('is-loose');
  };
  const set = (id: string | null, reveal = false, opts: { history?: boolean; instant?: boolean } = {}) => {
    // wide screens: no fold/unfold, see `.is-snap`. The row opened (or closed) glides to its new place.
    const prev = open;
    const snap = prev !== id && matchMedia('(min-width: 900px)').matches;
    const glide = snap && !(prev && id) && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const anchor = glide ? its.find((x) => x.dataset.r === (id ?? prev)) : undefined;
    const from = anchor?.getBoundingClientRect().top ?? 0;
    open = id;
    if (snap) rows.classList.add('is-snap');
    rows.classList.toggle('has-open', !!id);
    for (const tab of root.querySelectorAll<HTMLElement>('[data-tab]')) tab.setAttribute('aria-pressed', String(tab.dataset.tab === id));
    for (const it of its) {
      const on = it.dataset.r === id;
      it.classList.toggle('is-open', on);
      it.querySelector('.jr-who')!.setAttribute('aria-expanded', String(on));
      const film = it.querySelector('video');
      if (!film) continue;
      if (on) {
        if (!film.src) film.src = film.dataset.src!;
        film.play().catch(() => {});
      } else {
        film.pause();
        // back to the silent loop for the next time it opens
        if (film.controls) {
          film.controls = false;
          film.muted = film.loop = true;
          film.src = film.dataset.src!;
          it.querySelector<HTMLElement>('.jr-sound')!.hidden = false;
        }
      }
    }
    if (snap) {
      // commit the new layout with transitions off, then hand transitions back (running fades keep going)
      void rows.offsetHeight;
      requestAnimationFrame(() => rows.classList.remove('is-snap'));
      const dy = anchor ? from - anchor.getBoundingClientRect().top : 0;
      if (anchor && Math.abs(dy) > 0.5) {
        rows.classList.add('is-gliding');
        const g = anchor.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 380, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
        g.onfinish = g.oncancel = () => rows.classList.remove('is-gliding');
      }
    }
    tint(id);
    if (phone.matches) sheet(id, prev, opts);
    else if (!opts.history) history.replaceState(null, '', id ? `#${id}` : location.pathname + location.search);
    // opened from a summary: bring the row into view once it has its height
    // on narrow screens the project starts at the top of the screen, whatever folded above it
    if (id && reveal && !phone.matches) setTimeout(() => its.find((x) => x.dataset.r === id)!.scrollIntoView({ block: narrow.matches ? 'start' : 'nearest', behavior: 'smooth' }), 440);
  };
  root.addEventListener('click', (e) => {
    const el = e.target as Element;
    const o = el.closest<HTMLElement>('[data-open]');
    if (o) {
      e.preventDefault();
      const row = o.classList.contains('jr-who') || o.classList.contains('jr-tog');
      set(row && o.dataset.open === open ? null : o.dataset.open!, true);
      return;
    }
    if (el.closest('[data-close]')) return set(null);
    const g = el.closest<HTMLElement>('[data-goto]');
    if (g) {
      show(arts.findIndex((a) => a.dataset.day === g.dataset.goto), true);
      root.querySelector('.jr-lead')!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      return;
    }
    const sound = el.closest<HTMLElement>('.jr-sound');
    if (sound) {
      const film = sound.parentElement!.querySelector('video')!;
      film.src = film.dataset.full!;
      film.muted = film.loop = false;
      film.controls = true;
      film.play().catch(() => {});
      sound.hidden = true;
    }
  });
  root.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (lead.classList.contains('is-full')) return full(false);
    if (open) set(null);
  });
  for (const it of its) {
    const who = it.querySelector<HTMLElement>('.jr-who')!;
    who.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && tint(it.dataset.r!));
    who.addEventListener('pointerleave', () => tint(open));
  }
  document.addEventListener('themechange', () => requestAnimationFrame(() => tint(open)));
  // the address follows the open project; on phones the sheet is a step in history, so back closes it
  const fromHash = (first = false) => {
    const wanted = location.hash.slice(1);
    if (!wanted && open) {
      pushed = false;
      return set(null, false, { history: true });
    }
    if (wanted !== open && its.some((x) => x.dataset.r === wanted)) set(wanted, true, { history: true, instant: first });
  };
  addEventListener('hashchange', () => fromHash());
  fromHash(true);
  // turned sideways or resized out of the phone layout: put the sheet away cleanly
  phone.addEventListener('change', () => {
    for (const el of [...page(), ...its, ...root.querySelectorAll<HTMLElement>('.jr-rowline, .jr-axis-in')]) el.inert = false;
    if (open) set(null);
    full(false);
    show(kept, true);
    fit();
  });
  fit();
  document.fonts?.ready.then(fit);
  addEventListener('resize', fit, { passive: true });
</script>
