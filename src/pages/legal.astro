---
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Legal notice · Amont Labs"
  description="Legal notice for amontlabs.com."
  canonical="https://amontlabs.com/legal"
  robots="noindex"
>
  <Header />
  <main class="legal">
    <div class="wrap">
      <div class="legal-body">
        <h1>Legal notice</h1>
        <p class="mono dim sub">Mentions légales</p>

        <h2 class="mono dim">Publisher</h2>
        <p>Amont Labs, an independent project by Antton L., Paris, France.<br />Contact: <a class="link is-link" href="mailto:hello@amontlabs.com">hello@amontlabs.com</a></p>

        <h2 class="mono dim">Hosting</h2>
        <p>Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, United States.<br /><a class="link is-link" href="mailto:legalnotices@vercel.com">legalnotices@vercel.com</a> · <a class="link is-link" href="https://vercel.com">vercel.com</a></p>

        <h2 class="mono dim">Personal data</h2>
        <p>This site uses no cookies, no analytics and no third-party services. Fonts, images and code are served from this domain.</p>
        <p>Your theme choice (System, Light or Dark) is stored in your browser's local storage and never leaves your device.</p>
        <p>Like any host, Vercel processes technical request data (such as IP addresses) to serve and protect the site.</p>
        <p>For any question about your data: <a class="link is-link" href="mailto:hello@amontlabs.com">hello@amontlabs.com</a>.</p>

        <h2 class="mono dim">Source</h2>
        <p>The site's source code is public at <a class="link is-link" href="https://github.com/amontlabs/amontlabs.com">github.com/amontlabs/amontlabs.com</a>.</p>
      </div>
    </div>
  </main>
</Base>
