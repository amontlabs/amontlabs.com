---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Header />
  <main>
    <Hero />
    <Products />

    <section class="finale" aria-labelledby="about">
      <div class="wrap grid">
        <h2 id="about" class="sr-only">About Amont</h2>
        <p class="def">Amont, <i>n. m.</i> The upstream side of a river, toward its source. From <i>à mont</i>, “toward the mountain”.</p>
      </div>
    </section>
  </main>
</Base>
