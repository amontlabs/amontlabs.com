---
import HeaderLinks from "../components/HeaderLinks.astro";
import Hero from "../components/Hero.astro";
import Logo from "../components/Logo.astro";
import Silo from "../components/Silo.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <header class="top">
    <div class="wrap bar"><Logo /><ThemeSwitch /><HeaderLinks /></div>
  </header>
  <main>
    <Hero />
    <Silo />

    <section class="block" aria-labelledby="about">
      <div class="wrap grid">
        <h2 id="about" class="label mono dim" style="grid-column: 1 / -1">About</h2>
        <p class="def">Amont, <i>n. m.</i> The upstream side of a river, toward its source. From <i>à mont</i>, “toward the mountain”.</p>
      </div>
    </section>
  </main>
</Base>
