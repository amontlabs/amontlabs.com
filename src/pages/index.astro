---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Journal from "../components/Journal.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Header />
  <main class="is-landing">
    <Hero />
    <Journal />
    <footer class="foot wrap">
      <p>Amont, <i>n. m.</i> The upstream side of a river, toward its source. From <i>à mont</i>, “toward the mountain”.</p>
    </footer>
  </main>
</Base>

<style>
  /* one screen: the mountain takes whatever height the panel and the last line leave */
  .is-landing {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .is-landing :global(.hero) {
    flex: 1 0 auto;
    min-height: 132px !important;
  }
  .is-landing :global(section.block) {
    padding-top: 0 !important;
  }
  .is-landing :global(.hero-text) {
    display: none;
  }
  .foot {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    padding-top: 12px;
    padding-bottom: 16px;
  }
  .foot p {
    font-family: var(--serif);
    font-size: 14px;
    line-height: 20px;
    color: var(--secondary);
    text-align: right;
  }
  .foot p i {
    font-style: italic;
  }
  /* phones: the panel is a sheet down to the bottom; the last line sits on it, aligned with everything above */
  @media (max-width: 599px) {
    .foot {
      justify-content: flex-start;
      padding-top: 20px;
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
      background: var(--bg);
    }
    .foot p {
      text-align: left;
      text-wrap: pretty;
    }
  }
  /* phones held upright: exactly one screen. The mountain takes what the panel leaves; the last line only shows
     where there is room for it. If the panel ever outgrows the screen, the script sets .is-loose and it scrolls. */
  @media (max-width: 599px) and (min-height: 520px) {
    .is-landing:not(.is-loose) {
      height: 100svh;
      min-height: 0;
      overflow: hidden;
    }
    .is-landing:not(.is-loose) :global(.hero) {
      flex: 1 1 0;
      min-height: 48px !important;
    }
    .is-landing:not(.is-loose) .foot {
      display: none;
    }
  }
  @media (max-width: 599px) and (min-height: 800px) {
    .is-landing:not(.is-loose) .foot {
      display: flex;
      padding-top: 10px;
      padding-bottom: calc(18px + env(safe-area-inset-bottom));
    }
  }
</style>
