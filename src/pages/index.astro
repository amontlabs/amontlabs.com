---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Journal from "../components/Journal.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Header />
  <main class="is-landing">
    <Hero />
    <Journal />
    <footer class="foot wrap">
      <p>Amont, <i>n. m.</i> The upstream side of a river, toward its source. From <i>à mont</i>, “toward the mountain”.</p>
    </footer>
  </main>
</Base>

<style>
  /* one screen: the mountain takes whatever height the panel and the last line leave */
  .is-landing {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .is-landing :global(.hero) {
    flex: 1 0 auto;
    min-height: 132px !important;
  }
  .is-landing :global(section.block) {
    padding-top: 0 !important;
  }
  .is-landing :global(.hero-text) {
    display: none;
  }
  .foot {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    padding-top: 12px;
    padding-bottom: 16px;
  }
  .foot p {
    font-family: var(--serif);
    font-size: 14px;
    line-height: 20px;
    color: var(--secondary);
    text-align: right;
  }
  .foot p i {
    font-style: italic;
  }
</style>
