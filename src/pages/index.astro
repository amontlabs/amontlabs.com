---
import HeaderLinks from "../components/HeaderLinks.astro";
import Hero from "../components/Hero.astro";
import Logo from "../components/Logo.astro";
import Silo from "../components/Silo.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <header class="top">
    <div class="wrap bar"><Logo /><ThemeSwitch /><HeaderLinks /></div>
  </header>
  <main>
    <Hero />
    <Silo />

    <section class="block" aria-labelledby="about">
      <div class="wrap grid">
        <h2 id="about" class="label mono dim" style="grid-column: 1 / -1">About</h2>
        <p class="def">Amont, <i>n. m.</i> The upstream side of a river, toward its source. From <i>à mont</i>, “toward the mountain”.</p>
        <p class="mark-note dim">The accent after the name is a footnote mark, drawn as the summit where rivers begin.</p>
      </div>
    </section>
  </main>
  <footer>
    <div class="wrap">
      <div class="footrow">
        <p class="copy mono dim">© 2026 Amont Labs</p>
        <p class="contact">
          <a class="link" href="mailto:hello@amontlabs.com">hello@amontlabs.com</a>
          <a class="link" href="https://github.com/amontlabs">GitHub</a>
          <a class="link" href="https://x.com/amontlabs">X</a>
        </p>
      </div>
      <p class="signoff">En amont.</p>
    </div>
  </footer>
</Base>
