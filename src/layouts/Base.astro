---
import "../styles/global.css";
import geist500 from "../assets/fonts/geist-500.woff2?url";

const title = "Amont Labs";
const description = "Independent software studio in Paris. Practical, open-source software on emerging tech.";
const canonical = "https://amontlabs.com/";
const og = new URL("/og.png", canonical).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101418" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const KEY = "theme";
        const pref = () => {
          try { const v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : "system"; } catch { return "system"; }
        };
        const resolve = (p) => (p === "system" ? (mq.matches ? "dark" : "light") : p);
        const sync = () => {
          const t = d.dataset.theme;
          for (const s of document.querySelectorAll("source[data-theme]")) s.media = s.dataset.theme === t ? "all" : "not all";
        };
        const apply = (p) => {
          const t = resolve(p);
          d.dataset.theme = t;
          d.dataset.pref = p;
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = t === "dark" ? "#101418" : "#f7f8f5";
            m.removeAttribute("media");
          }
          sync();
          document.dispatchEvent(new CustomEvent("themechange", { detail: t }));
        };
        const set = (p) => {
          try { p === "system" ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, p); } catch {}
          const go = () => apply(p);
          if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.startViewTransition(() => {
              go();
              return new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
            });
          } else go();
        };
        mq.addEventListener("change", () => { if (pref() === "system") apply("system"); });
        window.__theme = { pref, set, sync, resolved: () => d.dataset.theme };
        apply(pref());
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geist500} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
  </head>
  <body>
    <slot />
  </body>
</html>
