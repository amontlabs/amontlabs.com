---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import "../styles/global.css";
import geist500 from "../assets/fonts/geist-500.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
}
const {
  title = "Amont Labs",
  description = "Practical, open-source software on emerging tech.",
  canonical = "https://amontlabs.com/",
  robots,
} = Astro.props;
// versioned by content, so a new card replaces the one platforms cached (bun scripts/make-og.mjs rebuilds it)
const ogv = createHash("sha256").update(readFileSync("public/og.png")).digest("hex").slice(0, 8);
const og = new URL(`/og.png?v=${ogv}`, canonical).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#f7f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101418" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const KEY = "theme";
        const pref = () => {
          try { const v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : "system"; } catch { return "system"; }
        };
        const resolve = (p) => (p === "system" ? (mq.matches ? "dark" : "light") : p);
        const sync = () => {
          const t = d.dataset.theme;
          for (const s of document.querySelectorAll("source[data-theme]")) s.media = s.dataset.theme === t ? "all" : "not all";
        };
        const apply = (p) => {
          const t = resolve(p);
          d.dataset.theme = t;
          d.dataset.pref = p;
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = t === "dark" ? "#101418" : "#f7f8f5";
            m.removeAttribute("media");
          }
          sync();
          document.dispatchEvent(new CustomEvent("themechange", { detail: t }));
        };
        const set = (p) => {
          try { p === "system" ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, p); } catch {}
          // plain CSS colour fade (no View Transitions: snapshotting the full-screen WebGL canvas
          // and swapping the poster sources mid-transition aborted it and could take the page down)
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
            d.classList.add("theme-anim");
            clearTimeout(window.__themeT);
            window.__themeT = setTimeout(() => d.classList.remove("theme-anim"), 650);
          }
          apply(p);
        };
        mq.addEventListener("change", () => { if (pref() === "system") apply("system"); });
        window.__theme = { pref, set, sync, resolved: () => d.dataset.theme };
        apply(pref());
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geist500} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Amont Labs logo and the sentence “Practical, open-source software on emerging tech.” beside a point-cloud mountain with a turquoise river, above the names of the featured projects." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
  </head>
  <body>
    <slot />
  </body>
</html>
